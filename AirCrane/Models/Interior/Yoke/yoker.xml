<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList>

  <path>yoke.ac</path>

  <effect>
    <inherits-from>Aircraft/AirCrane/Models/Effects/Interior/lm-interior-yoker</inherits-from>
    <object-name>manche</object-name>
    <object-name>btn1</object-name>
    <object-name>btn2</object-name>
    <object-name>btn3</object-name>
    <object-name>chapeau</object-name>
    <object-name>boot1</object-name>
    <object-name>boot2</object-name>
    <object-name>boot3</object-name>
    <object-name>boot4</object-name>
    <object-name>boot5</object-name>
    <object-name>boot6</object-name>
