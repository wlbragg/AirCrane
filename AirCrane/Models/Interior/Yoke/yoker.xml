  <animation>
	<name>Yoke</name>
    <object-name>manche</object-name>
    <object-name>btn1</object-name>
    <object-name>btn2</object-name>
    <object-name>btn3</object-name>
    <object-name>chapeau</object-name>
  </animation>
  
  	<animation>
		<type>rotate</type>
		<object-name>Yoke</object-name>
		<property>/fdm/jsbsim/fcs/Helicopter/cyclic_roll-pos-norm</property>
		<factor>-2</factor>
		<axis>
			<x>1</x>
		</axis>
	</animation>

	<animation>
		<type>rotate</type>
		<object-name>Yoke</object-name>
		<property>/fdm/jsbsim/fcs/Helicopter/cyclic_pitch-pos-norm</property>
		<factor>-2</factor>
		<axis>
			<y>1</y>
		</axis>
	</animation>

