	<animation>
		<type>select</type>
		<object-name>afcson</object-name>
		<condition>
			<property>/controls/electric/AFCS/Active</property>
		</condition>
	</animation>
	
	<animation>
		<object-name>afcson</object-name>
		<type>material</type>
		<condition>
			<property>/controls/electric/AFCS/Active</property>
		</condition>
		<emission>
			<green>0.25</green>
			<blue>0.25</blue>
		</emission>
	</animation>

	<animation>
		<type>select</type>
		<object-name>afcsoff</object-name>
		<condition>
			<not>
				<property>/controls/electric/AFCS/Active</property>
			</not>
		</condition>
	</animation>

