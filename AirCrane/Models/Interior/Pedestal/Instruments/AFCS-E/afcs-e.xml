	<animation>
		<type>pick</type>
		<object-name>baron</object-name>
		<visible>true</visible>
		<action>
			<button>0</button>
			<repeatable>false</repeatable>
			<binding>
				<command>property-toggle</command>
				<property>/controls/electric/bar_alt-sw</property>
			</binding>
			<binding>
				<command>nasal</command>
				<script>aircrane.click("avionics")</script>
			</binding>
		</action>
	</animation>
	
	<animation>
		<type>select</type>
		<object-name>baralton</object-name>
		<condition>
			<property>/controls/electric/AFCS/bar_alt</property>
