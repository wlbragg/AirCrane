  <!-- Yaw Trim "Knob" -->
	<animation>
		<type>knob</type>
		<object-name>yawtrim</object-name>
		<property>/controls/electric/yaw-trim</property>
		<factor>-60</factor>
		<offset-deg>0</offset-deg>
		<center>
			<x-m>0.03346</x-m>
			<y-m>-0.04460</y-m>
			<z-m>0.00448</z-m>
		</center>
		<axis>
			<z>1</z>
		</axis>
		<action>
			<repeatable>true</repeatable>
			<binding>
				<command>property-adjust</command>
				<property>/controls/electric/yaw-trim</property>
				<factor>0.001</factor>
				<min>-0.087266</min>
				<max>0.087266</max>
				<wrap>false</wrap>
			</binding>
		</action>
		<hovered>
			<binding>
				<command>set-tooltip</command>
				<tooltip-id>yawtrim</tooltip-id>
				<label>Yaw Trim: %s</label>
				<property>/controls/electric/yaw-trim</property>
			</binding>
		</hovered>
	</animation>

