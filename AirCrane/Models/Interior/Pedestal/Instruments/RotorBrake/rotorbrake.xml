<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList>

  <path>rotorbrake.ac</path>
 
	<effect>
		<inherits-from>Aircraft/AirCrane/Models/Effects/Interior/lm-interior-rotorbrakepanel</inherits-from>
		<object-name>base</object-name>
		<object-name>switchrotorbrake</object-name>
 		<object-name>rotorbrakeon</object-name>  	<!--  This order  -->
		 <object-name>rotorbrakeoff</object-name>  	<!--  is impotant -->		
	</effect>
	
<!-- Toggle Switch -->

	<animation>
		<type>pick</type>
		<object-name>switchrotorbrake</object-name>
		<visible>true</visible>
		<action>
			<button>0</button>
			<repeatable>false</repeatable>
			<binding>
				<command>property-toggle</command>
				<property>/controls/electric/rotor_brake-sw</property>
			</binding>
			<binding>
				<command>nasal</command>
				<script>aircrane.click("avionics")</script>
			</binding>
		</action>
	</animation>
	<animation>
		<type>rotate</type>
		<object-name>switchrotorbrake</object-name>
		<property>/controls/electric/rotor_brake-sw</property>
		<factor>-40</factor>
		<offset-deg>20</offset-deg>
		<center>
			<x-m>0.00516</x-m>
			<y-m>-0.01268</y-m>
			<z-m>0.00704</z-m>
		</center>
		<axis>
			<y>1</y>
		</axis>
	</animation>
	
<!-- Indicator Lamp -->

	<animation>
		<type>translate</type>
		<object-name>rotorbrakeon</object-name>
		<offset-m>-0.001</offset-m>
		<property>/controls/electric/alarms/rotor_brake</property>	
		<factor>0.002</factor>
		<axis>
			<z>1.0</z>
		</axis>
	</animation>
	<animation>
		<type>material</type>
		<object-name>rotorbrakeon</object-name>
		<condition>
			<equals>
				<property>/controls/electric/alarms/rotor_brake</property>
				<value>1</value>
			</equals>
		</condition>
		<emission>
			<factor-prop>/controls/electric/alarms/rotor_brake</factor-prop>
			<red>1</red>
		</emission>
	</animation>

</PropertyList>
