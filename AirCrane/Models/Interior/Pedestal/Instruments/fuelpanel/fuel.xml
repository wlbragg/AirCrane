    </hovered>
  </animation>

  <!-- X-Feed "Switch" -->
  
	<animation>
		<type>pick</type>
		<object-name>fuelxfeed</object-name>
		<visible>true</visible>
		<action>
			<button>0</button>
			<repeatable>false</repeatable>
			<binding>
				<command>property-toggle</command>
				<property>/controls/electric/tank_x_feed-sw</property>
			</binding>
			<binding>
				<command>nasal</command>
				<script>aircrane.click("avionics")</script>
			</binding>
		</action>
	</animation>
	<animation>
		<type>rotate</type>
		<object-name>fuelxfeed</object-name>
		<property>/controls/electric/tank_x_feed-sw</property>
		<factor>-30</factor>
		<center>
			<x-m>-0.00170</x-m>
			<y-m>0.00031</y-m>
			<z-m>0.00715</z-m>
		</center>
		<axis>
			<y>1</y>
		</axis>
	</animation>

  <!-- FWD Tank Pump 1 "Switch" -->
  
 	<animation>
		<type>pick</type>
		<object-name>fuelpump1eng1</object-name>
		<visible>true</visible>
		<action>
			<button>0</button>
			<repeatable>false</repeatable>
			<binding>
				<command>property-toggle</command>
				<property>/controls/electric/tank_fwd_pump-1-sw</property>
			</binding>
		</action>
	</animation>
	<animation>
		<type>rotate</type>
		<object-name>fuelpump1eng1</object-name>
		<property>/controls/electric/tank_fwd_pump-1-sw</property>
		<factor>-30</factor>
		<center>
			<x-m>0.04807</x-m>
			<y-m>-0.05897</y-m>
			<z-m>0.00759</z-m>
		</center>
		<axis>
			<y>1</y>
		</axis>
	</animation>

	<animation>
		<object-name>fail-fwd-tnk-pump1-on</object-name>
		<type>material</type>
		<condition>
			<and>
				<equals>
					<property>/controls/electric/cab_power</property>
					<value>1</value>
				</equals>
				<not>
					<property>/fdm/jsbsim/propulsion/tank_fwd/pump-1</property>
				</not>
			</and>
		</condition>
		<emission>
			<red>0.5</red>
		</emission>
	</animation>
	
	<model>
		<name>fuel-pump1-eng1-procedural</name>
		<path>Aircraft/AirCrane/Models/Effects/Interior/procedural_light_indicator_red.xml</path>
		<offsets>
			<x-m>0.011413</x-m>
			<y-m>-0.057677</y-m>
			<z-m>0.021221</z-m>
		</offsets>
		<condition>
			<and>
				<equals>
					<property>/controls/electric/cab_power</property>
					<value>1</value>
				</equals>
				<not>
					<property>/fdm/jsbsim/propulsion/tank_fwd/pump-1</property>
				</not>
			</and>
		</condition>
	</model>

