<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList>

  <path>fuel.ac</path>

  <animation>
    <object-name>fond</object-name>
    <object-name>face</object-name>
    <object-name>needle</object-name>
	<object-name>bug</object-name>
	<object-name>knob</object-name>
	
    <object-name>vitre</object-name>
  </animation>

  <effect>
    <inherits-from>Aircraft/AirCrane/Models/Effects/Interior/cockpit-interior</inherits-from>
    <object-name>fond</object-name>
    <object-name>face</object-name>
    <object-name>needle</object-name>
	<object-name>bug</object-name>
	<object-name>knob</object-name>
  </effect>

  <effect>
    <inherits-from>Aircraft/AirCrane/Models/Effects/Interior/interior-glass-reflection-panel-front</inherits-from>
    <object-name>vitre</object-name>
  </effect>

  <animation>
    <type>material</type>
    <object-name>face</object-name>
    <object-name>needle</object-name>
	<object-name>bug</object-name>
    <condition>
			<property>/controls/electric/cab_power</property>
    </condition>
    <emission>
      <factor-prop>controls/lighting/luminosite-lights</factor-prop>
      <red>   0.50 </red>
      <green> 0.40 </green>
      <blue>  0.30 </blue>
    </emission>
  </animation>

	<animation>
		<type>rotate</type>
		<object-name>needle</object-name>
		<property>/controls/electric/tank_aux-lbs</property>
		<interpolation>
			<entry><ind>-99</ind><dep>10</dep></entry>	
			<entry><ind>0</ind><dep>0</dep></entry>
			<entry><ind>3000</ind><dep>-282.5</dep></entry>
			<entry><ind>3300</ind><dep>-310</dep></entry>			
		</interpolation>
		<axis>
			<x>1</x>
		</axis>
	</animation>

	<animation>
		<type>knob</type>
		<object-name>knob</object-name>
		<property>/fdm/jsbsim/propulsion/tank[5]/fuel-bug</property>
		<factor>0.01</factor>
		<center>
			<y-m>0.0264</y-m>
			<z-m>-0.02804</z-m>
		</center>
		<axis>
			<x> 1 </x>
		</axis>
		<action>
			<binding>
				<command>property-adjust</command>
				<property>/fdm/jsbsim/propulsion/tank[5]/fuel-bug</property>
				<factor>100</factor>
				<min>0</min>
				<max>3300</max>
				<wrap>false</wrap>
			</binding>
		</action>
		<hovered>
			<binding>
				<command>set-tooltip</command>
				<tooltip-id>alt-setting</tooltip-id>
				<label>Refueling Stops @: %1.1f</label>
				<property>/fdm/jsbsim/propulsion/tank[5]/fuel-bug</property>
			</binding>
		</hovered>
	</animation>
  
	<animation>
		<type>rotate</type>
		<object-name>bug</object-name>
		<property>/fdm/jsbsim/propulsion/tank[5]/fuel-bug</property>
		<interpolation>
			<entry><ind>0</ind><dep>0</dep></entry>
			<entry><ind>3300</ind><dep>-310</dep></entry>
		</interpolation>
		<axis>
			<x> 1 </x>
		</axis>
	</animation>

</PropertyList>
