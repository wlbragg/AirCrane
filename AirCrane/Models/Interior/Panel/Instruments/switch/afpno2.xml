<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList>

	<path>switch.ac</path>

	<animation>
		<object-name>base</object-name>
		<object-name>switch</object-name>
	</animation>

	<!-- AUX Fuel Tank Pump 2 "Switch" -->
	<animation>
		<type>pick</type>
		<object-name>switch</object-name>
		<visible>true</visible>
		<action>
			<button>0</button>
			<repeatable>false</repeatable>
			<binding>
				<command>property-toggle</command>
				<property>/fdm/jsbsim/propulsion/tank[5]/pump-2</property>
			</binding>
			<binding>
				<command>nasal</command>
				<script>aircrane.click("avionics")</script>
			</binding>
		</action>
	</animation>
	<animation>
		<type>rotate</type>
		<object-name>switch</object-name>
		<property>/fdm/jsbsim/propulsion/tank[5]/pump-2</property>
		<factor>-60</factor>
		<offset-deg>30</offset-deg>
		<axis>
			<y>1</y>
		</axis>
	</animation>

	<animation>
		<type>material</type>
		<object-name>base</object-name>
		<object-name>switch</object-name>
		<condition>
			<property>systems/electrical/outputs/cabin-power</property>
		</condition>
		<emission>
			<factor-prop>controls/lighting/luminosite-lights</factor-prop>
			<red>   0.50 </red>
			<green> 0.40 </green>
			<blue>  0.30 </blue>
		</emission>
	</animation>

	<effect>
		<inherits-from>Aircraft/AirCrane/Models/Effects/Interior/cockpit-interior</inherits-from>
		<object-name>base</object-name>
		<object-name>switch</object-name>
	</effect>

</PropertyList>
