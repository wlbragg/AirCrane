  <animation>
    <type>pick</type>
    <object-name>switch</object-name>
    <visible>true</visible>
    <action>
      <button>0</button>
      <repeatable>false</repeatable>
      <binding>
        <command>property-toggle</command>
        <property>/controls/electric/cws_brightness-sw</property>
      </binding>
    </action>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>switch</object-name>
    <property>/controls/electric/cws_brightness-sw</property>
    <factor>-45</factor>
    <offset-deg>20</offset-deg>
    <axis>
      <x> 0.0 </x>
      <y> 1.0 </y>
      <z> 0.0 </z>
    </axis>
  </animation>

</PropertyList>
