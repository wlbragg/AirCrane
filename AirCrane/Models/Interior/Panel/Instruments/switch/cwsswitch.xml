    <type>material</type>
    <object-name>base</object-name>
    <object-name>switch</object-name>
    <condition>
      <property>systems/electrical/outputs/cabin-power</property>
    </condition>
    <emission>
      <factor-prop>/controls/lighting/luminosite-lights</factor-prop>
      <red>   0.50 </red>
      <green> 0.40 </green>
      <blue>  0.30 </blue>
    </emission>
