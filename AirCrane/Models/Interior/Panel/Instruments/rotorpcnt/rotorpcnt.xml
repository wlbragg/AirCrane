<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList>

  <path>rotorpcnt.ac</path>

  <animation>
    <object-name>fond</object-name>
    <object-name>face</object-name>
    <object-name>needle-rmpR</object-name>
    <object-name>needle-rmpL</object-name>
    <object-name>needle-percent</object-name>
    <object-name>vitre</object-name>
  </animation>

  <effect>
    <inherits-from>Aircraft/AirCrane/Models/Effects/Interior/cockpit-interior</inherits-from>
    <object-name>fond</object-name>
    <object-name>face</object-name>
    <object-name>needle-rmp1</object-name>
    <object-name>needle-rmp2</object-name>
    <object-name>needle-percent</object-name>
  </effect>

  <effect>
    <inherits-from>Aircraft/AirCrane/Models/Effects/Interior/interior-glass-reflection-panel-front</inherits-from>
    <object-name>vitre</object-name>
  </effect>

  <animation>
    <type>material</type>
    <object-name>face</object-name>
    <object-name>needle-rmp1</object-name>
    <object-name>needle-rmp2</object-name>
    <object-name>needle-percent</object-name>
    <condition>
      <property>/controls/electric/cab_power</property>
    </condition>
    <emission>
      <factor-prop>/controls/lighting/luminosite-lights</factor-prop>
      <red>   0.50 </red>
      <green> 0.40 </green>
      <blue>  0.30 </blue>
    </emission>
  </animation>

	<animation>
		<type>rotate</type>
		<object-name>needle-percent</object-name>
		<property>/controls/electric/rotor-rpm</property>
		<interpolation>
			<entry><ind>-99</ind><dep>10</dep></entry>		
			<entry><ind>0</ind><dep>0</dep></entry>
			<entry><ind>203.5</ind><dep>-275.0</dep></entry>
			<entry><ind>259</ind><dep>-350</dep></entry>			
		</interpolation>
		<axis>
			<x>1</x>
		</axis>
	</animation>

	<animation>
		<type>rotate</type>
		<object-name>needle-rpm1</object-name>
		<property>/controls/electric/turbine_1-hp</property>
		<interpolation>
			<entry><ind>-99</ind><dep>10</dep></entry>	
			<entry><ind>0</ind><dep>0</dep></entry>
			<entry><ind>4400</ind><dep>-275</dep></entry>			
			<entry><ind>5600</ind><dep>-350</dep></entry>
		</interpolation>
		<axis>
			<x>1</x>
		</axis>
	</animation>
	
	<animation>
		<type>rotate</type>
		<object-name>needle-rpm2</object-name>
		<property>/controls/electric/turbine_2-hp</property>
		<interpolation>
			<entry><ind>-99</ind><dep>10</dep></entry>	
			<entry><ind>0</ind><dep>0</dep></entry>
			<entry><ind>4400</ind><dep>-275</dep></entry>			
			<entry><ind>5600</ind><dep>-350</dep></entry>
		</interpolation>
		<axis>
			<x>1</x>
		</axis>
	</animation>


</PropertyList>
