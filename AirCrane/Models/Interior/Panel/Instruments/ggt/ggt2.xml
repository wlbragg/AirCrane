<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList>

	<path>ggt.ac</path>

	<animation>
		<object-name>fond</object-name>
		<object-name>face</object-name>
		<object-name>needle</object-name>
		<object-name>k-needle</object-name>
		<object-name>vitre</object-name>
	</animation>

	<effect>
		<inherits-from>/Aircraft/AirCrane/Models/Effects/Interior/cockpit-interior</inherits-from>
		<object-name>fond</object-name>
		<object-name>face</object-name>
		<object-name>needle</object-name>
		<object-name>k-needle</object-name>	
	</effect>

	<effect>
		<inherits-from>/Aircraft/AirCrane/Models/Effects/Interior/interior-glass-reflection-panel-front</inherits-from>
		<object-name>vitre</object-name>
	</effect>

	<animation>
		<type>material</type>
		<object-name>face</object-name>
		<object-name>needle</object-name>
		<object-name>k-needle</object-name>		
		<condition>
			<property>/controls/electric/cab_power</property>
		</condition>
			<emission>
			<factor-prop>/controls/lighting/luminosite-lights</factor-prop>
			<red>0.50</red>
			<green>0.40</green>
			<blue>0.30</blue>
		</emission>
	</animation>

	<animation>
		<type>rotate</type>
		<object-name>needle</object-name>
		<property>/controls/electric/turbine_2-n1</property>
		<interpolation>
			<entry><ind>-99</ind><dep>147</dep></entry>			
			<entry><ind>0</ind><dep>137</dep></entry>
			<entry><ind>100</ind><dep>-136</dep></entry>	  
			<entry><ind>104</ind><dep>-147</dep></entry>
		</interpolation>
		<axis>
			<x>1</x>
		</axis>
	</animation>
  
    <animation>
		<type>rotate</type>
		<object-name>k-needle</object-name>
		<center>
			<x-m>0.00226</x-m>
			<y-m>-0.009402</y-m>
			<z-m>0.012476</z-m>
		</center>
		<property>/fdm/jsbsim/propulsion/engine[4]/n1</property>
		<interpolation>
			<entry><ind>0</ind><dep>0</dep></entry>
			<entry><ind>100</ind><dep>-3600</dep></entry>	 	  
			<entry><ind>104</ind><dep>-3744</dep></entry>	  
		</interpolation>
		<axis>
			<x>1</x>
		</axis>
  </animation>

</PropertyList>
