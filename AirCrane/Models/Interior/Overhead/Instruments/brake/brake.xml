	<animation>
		<type>rotate</type>
		<object-name>rotorbrakehandle</object-name>
		<property>/controls/rotor_brake/handle_pos_norm</property>
		<factor>40</factor>
		<axis>
			<y>1</y>
		</axis>
	</animation>

	<animation>
		<type>rotate</type>
		<object-name>hydrod</object-name>
		<property>/controls/rotor_brake/handle_pos_norm</property>
		<factor>-5</factor>
		<center>
			<x-m>0.000011</x-m>
			<y-m>0.000000</y-m>
			<z-m>-0.00973</z-m>
		</center>
		<axis>
			<y>1</y>
		</axis>
	</animation>

	<animation>
		<type>translate</type>
		<object-name>hydpiston</object-name>
		<object-name>hydrod</object-name>
		<object-name>connector</object-name>
		<property>/controls/rotor_brake/handle_pos_norm</property>
		<factor>-0.00691</factor>
		<axis>
			<x>1</x>
		</axis>
	</animation>

</PropertyList>
