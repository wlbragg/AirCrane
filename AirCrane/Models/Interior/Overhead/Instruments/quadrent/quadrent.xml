<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList>

  <path>quadrent.ac</path>

  <effect>
    <inherits-from>Aircraft/AirCrane/Models/Effects/Interior/lm-interior-quadrent</inherits-from>
    <object-name>controlquadrant</object-name>
    <object-name>controlquadrantplates</object-name>
    <object-name>wire</object-name>
    <object-name>n1leverlstart</object-name>
    <object-name>n1leverrstart</object-name>
    <object-name>cqscrews</object-name>
    <object-name>redonl</object-name>
    <object-name>redoffl</object-name>
    <object-name>redonr</object-name>
    <object-name>redoffr</object-name>
    <object-name>fuelshutoffl</object-name>
    <object-name>fuelshutoffr</object-name>
    <object-name>n1leverl</object-name>
    <object-name>n1leverr</object-name>
    <object-name>fire</object-name>
    <object-name>redbase</object-name>
  </effect>

  <effect>
    <inherits-from>Aircraft/AirCrane/Models/Effects/Interior/interior-glass-reflection-panel-front</inherits-from>
    <object-name>n1leverlplastic</object-name>
    <object-name>n1leverrplastic</object-name>
  </effect>
  
<!-- TURBINE No.1 -->

	<animation>
		<type>select</type>
		<object-name>redoffl</object-name>
		<condition>
			<greater-than>
				<property>fdm/jsbsim/propulsion/engine[3]/n1</property>
				<value>60</value>
			</greater-than>
		</condition>
	</animation>

	<animation>
		<type>select</type>
		<object-name>redonl</object-name>
		<condition>
			<less-than>
				<property>fdm/jsbsim/propulsion/engine[3]/n1</property>
				<value>60</value>
			</less-than>
		</condition>
	</animation>

	<animation>
		<type>material</type>
		<object-name>redonl</object-name>
		<condition>
			<less-than>
				<property>fdm/jsbsim/propulsion/engine[3]/n1</property>
				<value>60</value>
			</less-than>
		</condition>	
		<emission>
			<red>0.7</red>
			<green>0.5</green>
			<blue>0.5</blue>
		</emission>
	</animation>

	<model>
		<name>low-turbine-pwr-quad-eng1</name>
		<path>Aircraft/AirCrane/Models/Effects/Interior/procedural_light_indicator_red.xml</path>
		<offsets>
			<x-m>0.025062</x-m>
			<y-m>-0.147786</y-m>
			<z-m>0.057731</z-m>
		</offsets>
		<condition>
			<less-than>
				<property>fdm/jsbsim/propulsion/engine[3]/n1</property>
				<value>60</value>
			</less-than>
		</condition>
	</model>

  	<animation>
		<type>pick</type>
		<object-name>fuelshutoffl</object-name>
		<visible>true</visible>
		<condition>
			<greater-than>
				<property>/fdm/jsbsim/propulsion/engine[3]/governor/n1-lever</property>
				<value>0.41</value>
			</greater-than>
		</condition>			
		<action>
			<button>0</button>
			<repeatable>false</repeatable>
			<binding>
				<command>property-toggle</command>
				<property>/controls/engines/engine[3]/fuel-cock</property>
			</binding>
			<binding>
				<command>nasal</command>
				<script>aircrane.click("avionics")</script>
			</binding>
		</action>
	</animation>
	<animation>
		<type>rotate</type>
		<object-name>fuelshutoffl</object-name>
		<property>/fdm/jsbsim/propulsion/engine[3]/fuel-cock</property>
		<factor>50</factor>
		<offset-deg>0</offset-deg>
		<center>
			<x-m>0.01717</x-m>
			<y-m>0.00000</y-m>
			<z-m>-0.01691</z-m>
		</center>
		<axis>
			<y>1</y>
		</axis>
	</animation>  

	<animation>
		<type>knob</type>
		<object-name>n1leverl</object-name>
		<object-name>n1leverlplastic</object-name>
		<condition>
			<equals>
				<property>/controls/engines/engine[3]/indent</property>
				<value>1</value>
			</equals>
		</condition>		
		<property>/fdm/jsbsim/propulsion/engine[3]/governor/n1-lever</property>
		<factor>40</factor>
		<center>
			<x-m>-0.03</x-m>
			<z-m>-0.01691</z-m>
		</center>
		<axis>
			<y>1</y>
		</axis>
		<action>
			<repeatable>false</repeatable>
			<binding>
				<command>property-adjust</command>
				<property>/fdm/jsbsim/propulsion/engine[3]/governor/n1-lever</property>
				<factor>0.02</factor>
				<min>0</min>
				<max>1</max>
				<wrap>0</wrap>
			</binding>
		</action>
		<hovered>
			<binding>
				<command>set-tooltip</command>
				<tooltip-id>eng1-n1</tooltip-id>
				<label>Engine 1 N1:  %3d</label>
				<mapping>percent</mapping>
				<property>/fdm/jsbsim/propulsion/engine[3]/governor/n1-lever</property>
			</binding>
		</hovered>
	</animation>

	<animation>
		<type>rotate</type>
		<object-name>n1leverlstart</object-name>
		<property>/fdm/jsbsim/propulsion/engine[3]/governor/n1-lever</property>
		<factor>40</factor>
		<center>
			<x-m>-0.03</x-m>
			<z-m>-0.01691</z-m>
		</center>
		<axis>
			<y>1</y>
		</axis>
	</animation>
	
	<animation>
		<type>knob</type>
		<object-name>n1leverlstart</object-name>
		<condition>
			<equals>
				<property>/fdm/jsbsim/propulsion/engine[3]/governor/n1-lever</property>
				<value>0</value>
			</equals>
		</condition>
		<action>
			<repeatable>false</repeatable>
			<binding> <!-- need this because of the way JSBsim turbine starter is coded -->
				<command>property-adjust</command>
				<property>/controls/engines/engine[3]/starter</property>
				<factor>0.1</factor>
				<min>0</min>
				<max>1</max>
				<wrap>0</wrap>
			</binding>
			<binding>
				<command>property-adjust</command>
				<property>/controls/electric/engine[3]/starter-sw</property>
				<factor>0.1</factor>
				<min>0</min>
				<max>1</max>
				<wrap>0</wrap>
			</binding>
			<binding>
				<command>property-adjust</command>
				<property>/controls/engines/engine[3]/indent</property>
				<factor>0.1</factor>
				<min>0</min>
				<max>1</max>
				<wrap>0</wrap>
			</binding>			
		</action>
		<hovered>
			<binding>
				<command>set-tooltip</command>
				<tooltip-id>eng1-start</tooltip-id>
				<label>Turbine 1 start</label>
			</binding>
		</hovered>
	</animation>

	<animation>
		<type>translate</type>
		<object-name>n1leverl</object-name>
		<object-name>n1leverlstart</object-name>
		<object-name>n1leverlplastic</object-name>
		<property>/controls/engines/engine[3]/indent</property>	
		<factor>0.003</factor>
		<axis>
			<x>1</x>
			<z>1</z>
		</axis>
	</animation>
	
	
	
