<?xml version="1.0"?>

<PropertyList>
<name>Avatar Scorpion HUD</name>

<enable3d>false</enable3d>

<label>
	<name>GROUND MODE</name>
	<width>1</width>
	<height>1</height>
	<x>-2</x>
	<y>-107.5</y>
	<halign>center</halign>
	<format>GROUND</format>
	<box>false</box>
	<option>center</option>	
</label>

<label>
	<name>Turbine 1</name>
	<width>1</width>
	<height>1</height>
	<x>-60</x>
	<y>40</y>
	<halign>center</halign>
	<format>Turbine 1</format>
	<box>false</box>
	<option>center</option>	
</label>
<label>
	<name>Turbine 1 OK</name>
	<width>1</width>
	<height>1</height>
	<x>-60</x>
	<y>27</y>
	<halign>center</halign>
	<format>OK</format>
	<box>false</box>
	<option>center</option>
  	<condition>
		<greater-than>
			<property>fdm/jsbsim/propulsion/engine[3]/propeller-rpm</property>
			<value>5750</value>
		</greater-than>
	</condition>	
</label>
<label>
	<name>Turbine 1 Stopped</name>
	<width>1</width>
	<height>1</height>
	<x>-60</x>
	<y>27</y>
	<halign>center</halign>
	<format>STOPPED</format>
	<box>false</box>
	<option>center</option>
  	<condition>
		<or>
			<and>
				<less-than>
					<property>fdm/jsbsim/propulsion/engine[3]/propeller-rpm</property>
					<value>10</value>
				</less-than>			
				<equals>
					<property>/controls/electric/tank_fwd_pump-1-sw</property>
					<value>0</value>
				</equals>
				<equals>
					<property>/controls/electric/tank_fwd_pump-2-sw</property>
					<value>0</value>
				</equals>
			</and>
			<equals>
				<property>/controls/engines/engine[3]/cutoff</property>
				<value>1</value>
			</equals>
		</or>
	</condition>	
</label>
<label>
	<name>Turbine 1 Starter</name>
	<width>1</width>
	<height>1</height>
	<x>-60</x>
	<y>27</y>
	<halign>center</halign>
	<format>STARTER</format>
	<box>false</box>
	<option>center</option>
  	<condition>
		<and>
			<less-than>
				<property>fdm/jsbsim/propulsion/engine[3]/propeller-rpm</property>
				<value>10</value>
			</less-than>
			<equals>
				<property>/controls/engines/engine[3]/cutoff</property>
				<value>0</value>
			</equals>
			<or>
				<equals>
					<property>/controls/electric/tank_fwd_pump-1-sw</property>
					<value>1</value>
				</equals>
				<equals>
					<property>/controls/electric/tank_fwd_pump-2-sw</property>
					<value>1</value>
				</equals>
			</or>
		</and>
	</condition>	
</label>
<label>
	<name>Turbine 1 rpm</name>
	<width>1</width>
	<height>5</height>
	<x>-60</x>
	<y>20</y>
	<halign>right</halign>
	<format>%.0f</format>
	<box>false</box>
	<option>center</option>
	<input>
		<property>fdm/jsbsim/propulsion/engine[3]/propeller-rpm</property>
	</input>
  	<condition>
		<and>
			<greater-than>
				<property>fdm/jsbsim/propulsion/engine[3]/propeller-rpm</property>
				<value>10</value>
			</greater-than>
			<less-than>
				<property>fdm/jsbsim/propulsion/engine[3]/propeller-rpm</property>
				<value>5750</value>
			</less-than>
		</and>
	</condition>	
</label>
<gauge>
	<name>Turbine 1 rpm</name>
	<x>-60</x>
	<y>-90</y>
	<width>10</width>
	<height>120</height>
	<option>vertical</option>
	<option>left</option>
	<option>notext</option>
	<major-divisions>1000</major-divisions>
	<minor-divisions>0</minor-divisions>
	<enable-pointer>true</enable-pointer>
	<pointer-type>fixed</pointer-type>
	<input>
		<property>fdm/jsbsim/propulsion/engine[3]/propeller-rpm</property>
		<max>9000</max>
		<min>0</min>
	</input>
  	<condition>
		<and>
			<greater-than>
				<property>fdm/jsbsim/propulsion/engine[3]/propeller-rpm</property>
				<value>10</value>
			</greater-than>
			<less-than>
				<property>fdm/jsbsim/propulsion/engine[3]/propeller-rpm</property>
				<value>5750</value>
			</less-than>
		</and>
	</condition>	
</gauge>

