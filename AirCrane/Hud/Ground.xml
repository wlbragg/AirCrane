<!-- External Power -->

<label>
	<name>External Power</name>
	<width>90</width>
	<height>10</height>
	<x>-45</x>
	<y>-20</y>
	<halign>l</halign>
	<format>EXTERNAL POWER</format>
	<box>true</box>
	<option>center</option>
  	<condition>
		<and>
			<greater-than>
				<property>/sim/hud/flashing</property>
				<value>0.5</value>
			</greater-than>
			<or>
				<equals>
					<property>/controls/electric/engine[3]/rectifier</property>
					<value>1</value>
				</equals>
				<equals>
					<property>/controls/electric/engine[4]/rectifier</property>
					<value>1</value>
				</equals>
			</or>
			<or>
				<greater-than>
					<property>/fdm/jsbsim/propulsion/engine[3]/n1</property>
					<value>42</value>
				</greater-than>
				<greater-than>
					<property>/fdm/jsbsim/propulsion/engine[4]/n1</property>
					<value>42</value>
				</greater-than>								
			</or>
			<equals>
				<property>/controls/electric/external_power</property>
				<value>1</value>
			</equals>
		</and>
	</condition>
</label>
















