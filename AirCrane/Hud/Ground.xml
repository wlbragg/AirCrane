	<name>Main Rotor rpm</name>
	<width>1</width>
	<height>5</height>
	<x>0</x>
	<y>80</y>
	<halign>center</halign>
	<format>%.0f</format>
	<postfix>:rpm</postfix>	
	<box>false</box>
	<option>center</option>
	<input>
		<property>fdm/jsbsim/propulsion/engine[1]/propeller-rpm</property>
