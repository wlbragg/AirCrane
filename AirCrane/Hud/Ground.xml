<label>
	<name>Ok for take-off</name>
	<width>90</width>
	<height>10</height>
	<x>-45</x>
	<y>-20</y>
	<halign>l</halign>
	<format>OK FOR TAKE-OFF</format>
	<box>true</box>
	<option>center</option>
  	<condition>
		<and>
			<greater-than>
				<property>/sim/hud/flashing</property>
				<value>0.5</value>
			</greater-than>
			<greater-than>
				<property>fdm/jsbsim/propulsion/engine[1]/propeller-rpm</property>
				<value>180</value>
			</greater-than>
			<greater-than>
				<property>fdm/jsbsim/propulsion/engine[3]/propeller-rpm</property>
				<value>8900</value>
			</greater-than>
			<greater-than>
				<property>fdm/jsbsim/propulsion/engine[4]/propeller-rpm</property>
				<value>8900</value>
			</greater-than>
			<equals>
				<property>/controls/electric/external_power</property>
				<value>0</value>
			</equals>			
		</and>
	</condition>
</label>

