			<value>0</value>
		</less-than>
	</condition>
</label>

<gauge>
	<name>bar right</name>
	<x>10</x>
	<y>-55</y>
	<width>13</width>
	<height>1</height>
	<option>horizontal</option>
	<option>top</option>
	<option>notext</option>
	<enable-pointer>false</enable-pointer>
	<pointer-type>fixed</pointer-type>
	<input>
		<property>fdm/jsbsim/velocities/u-fps</property>
