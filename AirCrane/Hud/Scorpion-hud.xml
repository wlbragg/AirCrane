			<value>0</value>
		</greater-than>
	</condition>
</label>

<label>
	<name>VSI upper</name>
	<width>1</width>
	<height>5</height>
	<x>70</x>
	<y>-35</y>
	<halign>center</halign>
	<format>%.0f</format>
	<postfix>fps</postfix>
	<box>false</box>
	<option>center</option>
	<input>
		<property>fdm/jsbsim/velocities/w-fps</property>
	</input>
  	<condition>
		<less-than>
			<property>fdm/jsbsim/velocities/w-fps</property>
			<value>0</value>
		</less-than>
	</condition>	
</label>
<gauge>
	<name>VSI</name>
	<x>55</x>
	<y>-90</y>
	<width>10</width>
	<height>75</height>
	<option>vertical</option>
	<option>right</option>
	<option>notext</option>
	<major-divisions>5</major-divisions>
	<minor-divisions>5</minor-divisions>
	<enable-pointer>true</enable-pointer>
	<pointer-type>fixed</pointer-type>
	<input>
		<property>/velocities/vertical-speed-fps</property>
		<max>20</max>
		<min>-20</min>
	</input>
   	<condition>		
		<or>
			<greater-than>
				<property>fdm/jsbsim/velocities/w-fps</property>
				<value>5</value>
			</greater-than>
			<less-than>
				<property>fdm/jsbsim/velocities/w-fps</property>
				<value>-5</value>
			</less-than>
		</or>
	</condition> 
</gauge>
<gauge>
	<name>VSI</name>
	<x>55</x>
	<y>-90</y>
	<width>10</width>
	<height>75</height>
	<option>vertical</option>
	<option>right</option>
	<option>text</option>
	<major-divisions>5</major-divisions>
	<minor-divisions>2.5</minor-divisions>
	<enable-pointer>true</enable-pointer>
	<pointer-type>fixed</pointer-type>
	<input>
		<property>/velocities/vertical-speed-fps</property>
		<max>5</max>
		<min>-5</min>
	</input>
   	<condition>
		<and>
			<and>
				<less-than>
					<property>fdm/jsbsim/velocities/w-fps</property>
					<value>5</value>
				</less-than>
				<greater-than>
					<property>fdm/jsbsim/velocities/w-fps</property>
					<value>-5</value>
				</greater-than>
			</and>			
			<or>
				<greater-than>
					<property>fdm/jsbsim/velocities/w-fps</property>
					<value>2</value>
				</greater-than>
				<less-than>
					<property>fdm/jsbsim/velocities/w-fps</property>
					<value>-2</value>
				</less-than>
			</or>
		</and>
	</condition> 
</gauge>
<gauge>
	<name>VSI</name>
	<x>55</x>
	<y>-90</y>
	<width>10</width>
	<height>75</height>
	<option>vertical</option>
	<option>right</option>
	<option>text</option>
	<major-divisions>2</major-divisions>
	<minor-divisions>2</minor-divisions>
	<enable-pointer>true</enable-pointer>
	<pointer-type>fixed</pointer-type>
	<input>
		<property>/velocities/vertical-speed-fps</property>
		<max>2</max>
		<min>-2</min>
	</input>
   	<condition>
		<and>
			<less-than>
				<property>fdm/jsbsim/velocities/w-fps</property>
				<value>2</value>
			</less-than>
			<greater-than>
				<property>fdm/jsbsim/velocities/w-fps</property>
				<value>-2</value>
			</greater-than>
		</and>
	</condition>  
</gauge>
<label>
	<name>VSI lower</name>
	<width>1</width>
	<height>5</height>
	<x>70</x>
	<y>-72</y>
	<halign>center</halign>
	<format>%.0f</format>
