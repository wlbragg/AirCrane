<?xml version="1.0"?>

<PropertyList>
<name>Manual HUD</name>

<enable3d>false</enable3d>

<label>
	<name>IAS</name>
	<width>1</width>
	<height>1</height>
	<x>0</x>
	<y>-95</y>
	<halign>center</halign>
	<prefix>IAS </prefix>	
	<format>%.0f</format>
	<postfix>kts</postfix>
	<box>false</box>
	<option>center</option>
	<input>
		<property>/velocities/airspeed-kt</property>
	</input> 
</label>

<label>
	<name>IAS</name>
	<width>1</width>
	<height>1</height>
	<x>0</x>
	<y>-55</y>
	<halign>center</halign>
	<format>fps</format>
	<box>false</box>
	<option>center</option>
</label>

<label>
	<name>Forwards</name>
	<width>1</width>
	<height>1</height>
	<x>0</x>
	<y>-30</y>
	<halign>center</halign>
	<format>%.0f</format>
	<box>false</box>
	<option>center</option>
	<input>
		<property>/fdm/jsbsim/velocities/u-fps</property>
	</input>
  	<condition>
		<greater-than>
			<property>fdm/jsbsim/velocities/u-fps</property>
			<value>0</value>
		</greater-than>
	</condition>
</label>

<gauge>
	<name>bar up</name>
	<x>0</x>
	<y>-50</y>
	<width>1</width>
	<height>15</height>
	<option>vertical</option>
	<option>left</option>
	<option>notext</option>
	<enable-pointer>false</enable-pointer>
	<pointer-type>fixed</pointer-type>
	<input>
		<property>fdm/jsbsim/velocities/u-fps</property>
	</input>
</gauge>

<gauge>
	<name>bar down</name>
	<x>0</x>
	<y>-75</y>
	<width>1</width>
	<height>15</height>
	<option>vertical</option>
	<option>left</option>
	<option>notext</option>
	<enable-pointer>false</enable-pointer>
	<pointer-type>fixed</pointer-type>
	<input>
		<property>fdm/jsbsim/velocities/u-fps</property>
	</input>
</gauge>

<label>
	<name>Backwards</name>
	<width>1</width>
	<height>1</height>
	<x>0</x>
	<y>-82</y>
	<halign>center</halign>
	<format>%.0f</format>
