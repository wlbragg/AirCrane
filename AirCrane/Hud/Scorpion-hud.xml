<label>
	<name>Left</name>
	<width>1</width>
	<height>1</height>
	<x>-23</x>
	<y>-56</y>
	<halign>right</halign>
	<format>%.0f</format>
	<box>false</box>
	<option>center</option>
	<input>
		<property>/fdm/jsbsim/velocities/v-fps</property>
	</input>
  	<condition>
		<less-than>
			<property>fdm/jsbsim/velocities/v-fps</property>
			<value>0</value>
		</less-than>
	</condition>
</label>

<label>
	<name>Right</name>
	<width>1</width>
	<height>1</height>
	<x>23</x>
	<y>-56</y>
	<halign>left</halign>
	<format>%.0f</format>
	<box>false</box>
	<option>center</option>
	<input>
		<property>/fdm/jsbsim/velocities/v-fps</property>
	</input>
  	<condition>
		<greater-than>
