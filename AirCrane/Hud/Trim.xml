		<property>/fdm/jsbsim/velocities/u-fps</property>
	</input>
  	<condition>
		<less-than>
			<property>fdm/jsbsim/velocities/u-fps</property>
			<value>0</value>
		</less-than>
	</condition>
</label>

<gauge>
	<name>bar right</name>
	<x>10</x>
	<y>-55</y>
