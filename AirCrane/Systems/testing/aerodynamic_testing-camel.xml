<?xml version="1.0"?>

<system name="preset for testing">

	<channel name="brake">
	
		<switch name="/controls/gear/brake-parking">
			<default value="1"/>
				<test value="1">
					/controls/gear/brake-parking EQ 0
				</test>
		</switch>
		
	</channel>

	<property type="double" value="1">T4T/test/roll_lock--on</property>

	<channel name="roll" execute="T4T/test/roll_lock--on">
		
		<switch name="T4T/test/roll_adjustment">
			<default value="0"/>
				<test value="-0.001">
					attitude/roll-rad LT 0
				</test>
				<test value="0.001">
					attitude/roll-rad GT 0
				</test>
		</switch>		
 
		<summer>
			<input>gear/unit[3]/z-position</input>
			<input>T4T/test/roll_adjustment</input>
			<output>gear/unit[3]/z-position</output>
			<output>gear/unit[5]/z-position</output>				
		</summer>

		<switch>
			<default value="1"/>
				<test logic="AND" value="0">
					attitude/roll-rad LT 0.00001
					attitude/roll-rad GT -0.00001
				</test>
				<output>T4T/test/roll_lock--on</output>
		</switch>		
		
	</channel>	
	

	<property type="double" value="0">T4T/test/alpha_lock--on</property>	
	<property type="double" value="0">T4T/test/alpha_target-deg</property>	
	
	<channel name="alpha" execute="T4T/test/alpha_lock--on">	
		
		<switch name="T4T/test/alpha_adjustment">
			<default value="0"/>
				<test value="0.001">
					aero/alpha-deg LT T4T/test/alpha_target-deg
				</test>
				<test value="-0.001">
					aero/alpha-deg GT T4T/test/alpha_target-deg
				</test>
		</switch>		
 
		<summer>
			<input>gear/unit[5]/z-position</input>
			<input>T4T/test/alpha_adjustment</input>
			<output>gear/unit[5]/z-position</output>			
		</summer>
		<summer>
			<input>gear/unit[6]/z-position</input>
			<input>T4T/test/alpha_adjustment</input>
			<output>gear/unit[6]/z-position</output>				
		</summer>
		
		<summer>
			<input>aero/alpha-deg</input>
			<input>-T4T/test/alpha_target-deg</input>
			<output>T4T/test/alpha_acuracy</output>				
		</summer>
		
	</channel>
	
	<channel name="alpha_check">
	
		<switch>
			<default value="1"/>
				<test logic="AND" value="0">
					T4T/test/alpha_acuracy LT 0.00001
					T4T/test/alpha_acuracy GT -0.00001
				</test>
				<output>T4T/test/alpha_lock--on</output>
		</switch>		
	
	</channel>
	
	<property type="double" value="0">T4T/test/Cl_lock--on</property>	
	<property type="double" value="1">T4T/test/Cl_target</property>	
	
	<channel name="Cl" execute="T4T/test/Cl_lock--on">
	
	
		<fcs_function>
			<function>
				<quotient>
					<property>T4T/test/Cl_target</property>				
					<property>aero/coefficient/CL</property>																	
				</quotient>
			</function>
			<output>T4T/test/Cl_accuracy</output>
		</fcs_function>
 		<fcs_function> 
			<function>
				<table>
					<independentVar lookup="row">T4T/test/Cl_accuracy</independentVar>				
					<tableData>
						0.8		-0.01
						1.00	0.000001
						1.2		0.01
					</tableData>
				</table>
			</function>
			<output>T4T/test/Cl_adjustment</output>
		</fcs_function>			
		
		<summer>
			<input>gear/unit[5]/z-position</input>
			<input>T4T/test/Cl_adjustment</input>
			<output>gear/unit[5]/z-position</output>				
		</summer>
		<summer>
			<input>gear/unit[6]/z-position</input>
			<input>T4T/test/Cl_adjustment</input>		
			<output>gear/unit[6]/z-position</output>		
		</summer>		
	
	</channel>
	
	<property type="double" value="0">T4T/test/height_lock--on</property>	
	<property type="double" value="1.1">T4T/test/height_target-pct</property>	
	
	<channel name="height_AGL" execute="T4T/test/height_lock--on">
	
		<pure_gain>
			<input>metrics/bw-ft</input>
			<gain>T4T/test/height_target-pct</gain>
			<output>T4T/test/height_target-ft</output>
		</pure_gain>

		<fcs_function>
			<function>
				<quotient>
					<property>T4T/test/height_target-ft</property>				
					<property>position/h-agl-ft</property>																	
				</quotient>
			</function>
			<output>T4T/test/height_accuracy</output>
		</fcs_function>
		
 		<fcs_function> 
			<function>
				<table>
					<independentVar lookup="row">T4T/test/height_accuracy</independentVar>				
					<tableData>
						0.8		0.2
						1.00	0.0005
						1.2		-0.2
					</tableData>
				</table>
			</function>
			<output>T4T/test/height_adjustment</output>
		</fcs_function>			

		<summer>
			<input>gear/unit[3]/z-position</input>
			<input>T4T/test/height_adjustment</input>
			<output>gear/unit[3]/z-position</output>	
		</summer>
		<summer>
			<input>gear/unit[4]/z-position</input>
			<input>T4T/test/height_adjustment</input>
			<output>gear/unit[4]/z-position</output>		
		</summer>		
		<summer>
			<input>gear/unit[5]/z-position</input>
			<input>T4T/test/height_adjustment</input>
			<output>gear/unit[5]/z-position</output>			
		</summer>
		<summer>
			<input>gear/unit[6]/z-position</input>
			<input>T4T/test/height_adjustment</input>			
			<output>gear/unit[6]/z-position</output>
		</summer>		
	
	</channel>
	
	<property type="double" value="0">T4T/test/kCLge--on</property>	
	<property type="double" value="1">OWS/coefficients/kCLge</property>
	
	<channel name="kCLge" execute="T4T/test/kCLge--on">
	
		<fcs_function> 
			<function>
				<product>
					<value>2</value>
					<table>
						<independentVar lookup="row">aero/h_b-mac-ft</independentVar>				
						<tableData>
							0		1.203
							0.1		1.127
							0.15	1.09
							0.2		1.073
							0.3		1.046
							0.4		1.028
							0.5		1.019
							0.6		1.013
							0.7		1.008
							0.8		1.006
							0.9		1.003
							1		1.002
							1.1		1
						</tableData>
					</table>
				</product>
			</function>
			<output>T4T/test/Cl_target</output>		
		</fcs_function>
		
		<switch name="T4T/test/kCLge-adjustment">
			<default value="0"/>
				<test value="0.001">
					OWS/coefficients/Cl LT T4T/test/Cl_target
				</test>
				<test value="-0.001">
					OWS/coefficients/Cl GT T4T/test/Cl_target
				</test>
		</switch>
		<summer>
			<input>OWS/coefficients/kCLge</input>
			<input>T4T/test/kCLge-adjustment</input>
			<output>OWS/coefficients/kCLge</output>
		</summer>	
	
	</channel>
	
	<property type="double" value="0">T4T/test/kCdige--on</property>		
	
	<channel name="kCdige" execute="T4T/test/kCdige--on">
	
		<fcs_function> 
			<function>
				<product>
					<value>0.1449</value>
					<table>
						<independentVar lookup="row">aero/h_b-mac-ft</independentVar>				
						<tableData>
							0		0.000
							0.05	0.3
							0.1		0.515
							0.15	0.629
							0.2		0.709
							0.3		0.815
							0.4		0.882
							0.5		0.928
							0.6		0.962
							0.7		0.980
							0.8		0.990
							0.9		0.995
							1		0.999
							1.1		1.000
						</tableData>
					</table>
				</product>
			</function>
			<output>T4T/test/Cdi_target</output>		
		</fcs_function>
		
		<fcs_function> 
			<function>
				<quotient>
					<property>T4T/test/Cdi_target</property>				
					<property>OWS/coefficients/Cdi</property>					
				</quotient>
			</function>
			<output>T4T/test/kCdige</output>		
		</fcs_function>

	</channel>		

</system>   