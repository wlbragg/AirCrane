			<gain>4</gain>
		</pure_gain>
		
		<pure_gain name="propulsion/engine[1]/rotor/blade_2/dihedral-deg">
			<input>propulsion/engine[1]/rotor/blade_2/flex-deg</input>
			<gain>4</gain>
		</pure_gain>		
		
