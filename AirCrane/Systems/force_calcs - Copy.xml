		</pure_gain>

		<!-- blade pairs dihedral -->

		<summer name="propulsion/engine[1]/rotor/dihedral_1-4-deg">
			<input>propulsion/engine[1]/rotor/blade_1/dihedral-deg</input>
			<input>-propulsion/engine[1]/rotor/blade_4/dihedral-deg</input>
		</summer>		

		<summer name="propulsion/engine[1]/rotor/dihedral_2-5-deg">
			<input>propulsion/engine[1]/rotor/blade_2/dihedral-deg</input>
			<input>-propulsion/engine[1]/rotor/blade_5/dihedral-deg</input>
		</summer>
		
		<summer name="propulsion/engine[1]/rotor/dihedral_3-6-deg">
			<input>propulsion/engine[1]/rotor/blade_3/dihedral-deg</input>
			<input>-propulsion/engine[1]/rotor/blade_6/dihedral-deg</input>
		</summer>

		<!-- roll/pitch dihedral -->
		
		<fcs_function name="propulsion/engine[1]/rotor/dihedral_roll-deg">
			<function>
					<ifthen>
						<or>
							<and>
								<lt>
									<property>propulsion/engine[1]/rotor/blade_1/rotation-rad</property>
									<value>1.658063</value>
								</lt>
								<gt>
									<property>propulsion/engine[1]/rotor/blade_1/rotation-rad</property>
									<value>1.48353</value>
								</gt>
							</and>
							<and>
								<lt>
									<property>propulsion/engine[1]/rotor/blade_4/rotation-rad</property>
									<value>1.658063</value>
								</lt>
								<gt>
									<property>propulsion/engine[1]/rotor/blade_4/rotation-rad</property>
									<value>1.48353</value>
								</gt>
							</and>
						</or>
						<property>propulsion/engine[1]/rotor/dihedral_1-4-deg</property>					
						<property>propulsion/engine[1]/rotor/dihedral_roll-deg</property>	
					</ifthen>
			</function>		
		</fcs_function>		
		
		<fcs_function name="propulsion/engine[1]/rotor/dihedral_pitch-rad">
			<function>
				<toradians>
					<sum name="propulsion/engine[1]/rotor/dihedral_pitch-deg">
						<!-- <value>3</value> --> <!-- rotor rigging angle -->
						<product>
							<cos>
								<property>propulsion/engine[1]/rotor/blade_1/rotation-rad</property>					
							</cos>
							<property>propulsion/engine[1]/rotor/dihedral_1-4-deg</property>
						</product>
						<product>
							<cos>
								<property>propulsion/engine[1]/rotor/blade_2/rotation-rad</property>					
							</cos>
							<property>propulsion/engine[1]/rotor/dihedral_2-5-deg</property>
						</product>
						<product>
							<cos>
								<property>propulsion/engine[1]/rotor/blade_3/rotation-rad</property>					
							</cos>
							<property>propulsion/engine[1]/rotor/dihedral_3-6-deg</property>
						</product>
					</sum>
				</toradians>
			</function>
		</fcs_function>

		<!-- Forces -->

		<fcs_function name="propulsion/engine[1]/rotor/X-lbs">
			<function>
				<product>
					<property>-propulsion/engine[1]/rotor/thrust-lbs</property>
					<sin><property>propulsion/engine[1]/rotor/dihedral_pitch-rad</property></sin>
				</product>
			</function>
		</fcs_function>

		<fcs_function name="propulsion/engine[1]/rotor/Y-lbs">
			<function>
				<product>
					<property>-propulsion/engine[1]/rotor/thrust-lbs</property>
					<sin>
						<toradians>
							<property>propulsion/engine[1]/rotor/dihedral_roll-deg</property>
						</toradians>							
					</sin>
				</product>
			</function>
		</fcs_function>

		<fcs_function name="propulsion/engine[1]/rotor/Z-lbs">
			<function>
				<product>
					<property>-propulsion/engine[1]/rotor/thrust-lbs</property>
					<cos>
						<toradians>
							<property>propulsion/engine[1]/rotor/dihedral_roll-deg</property>
						</toradians>							
					</cos>
					<cos><property>propulsion/engine[1]/rotor/dihedral_pitch-rad</property></cos>
				</product>
			</function>
		</fcs_function>

		<!-- Centre of Pressure -->
		
		<!-- cyclic -->
		
		<fcs_function name="moments/cyclic_l-lbsft">
			<function>
					<sum>
						<product>
							<cos>
								<property>propulsion/engine[1]/rotor/blade_1/rotation-rad</property>					
							</cos>
							<property>propulsion/engine[1]/rotor/blades_1-4/moment-lbsft</property>
						</product>
						<product>
							<cos>
								<property>propulsion/engine[1]/rotor/blade_2/rotation-rad</property>					
							</cos>
							<property>propulsion/engine[1]/rotor/blades_2-5/moment-lbsft</property>
						</product>
						<product>
							<cos>
								<property>propulsion/engine[1]/rotor/blade_3/rotation-rad</property>					
							</cos>
							<property>propulsion/engine[1]/rotor/blades_3-6/moment-lbsft</property>
						</product>
					</sum>
			</function>
		</fcs_function>		
		
		<fcs_function name="moments/cyclic_m-lbsft">
			<function>
					<sum>
						<product>
							<sin>
								<property>propulsion/engine[1]/rotor/blade_1/rotation-rad</property>					
							</sin>
							<property>propulsion/engine[1]/rotor/blades_1-4/moment-lbsft</property>
						</product>
						<product>
							<sin>
								<property>propulsion/engine[1]/rotor/blade_2/rotation-rad</property>					
							</sin>
							<property>propulsion/engine[1]/rotor/blades_2-5/moment-lbsft</property>
						</product>
						<product>
							<sin>
								<property>propulsion/engine[1]/rotor/blade_3/rotation-rad</property>					
							</sin>
							<property>propulsion/engine[1]/rotor/blades_3-6/moment-lbsft</property>
						</product>
					</sum>
			</function>
		</fcs_function>

		<!-- Ground Effect -->

		<fcs_function name="propulsion/engine[1]/rotor/vertical-lbs">
			<function>
				<product>
					<property>propulsion/engine[1]/rotor/Z-lbs</property>
					<cos><property>attitude/pitch-rad</property></cos>
					<cos><property>attitude/roll-rad</property></cos>
				</product>
			</function>
		</fcs_function>

		<scheduled_gain name="propulsion/engine[1]/rotor/ground_effect-lbs">
			<!-- 	http://www.copters.com/aero/ground_effect.html											-->
			<input>propulsion/engine[1]/rotor/vertical-lbs</input>
			<table>
				<independentVar lookup="row">position/h-agl-ft</independentVar>
				<independentVar lookup="column">velocities/vg-fps</independentVar>
				<tableData>
								0.000		8.44
					2.74		0.500		0.00		<!-- 1/8 -->
					5.49		0.150		0.00		<!-- 1/4 -->
					10.97		0.070		0.00		<!-- 1/2 -->
					16.46		0.025		0.00		<!-- 3/4 -->
					21.95		0.020		0.00		<!-- 1 -->
					27.43		0.005		0.00		<!-- 1 1/4 -->
					32.92		0.000		0.00		<!-- 1 1/2 -->
				</tableData>
			</table>
		</scheduled_gain>

	</channel>

	<channel name="Forces">

		<summer>													
			<input>propulsion/engine[1]/rotor/X-lbs</input>												
			<input>forces/drag_x-lbs</input>												
			<output>forces/fbx-lbs</output>												
		</summer>													

		<summer>
			<input>propulsion/engine[1]/rotor/Y-lbs</input>
			<input>propulsion/engine[2]/rotor/Y-lbs</input>
			<input>forces/drag_y-lbs</input>				
			<output>forces/fby-lbs</output>				
		</summer>

		<summer>
			<input>propulsion/engine[1]/rotor/Z-lbs</input>
			<input>forces/drag_z-lbs</input>
			<output>forces/fbz-lbs</output>				
		</summer>

	</channel>

	<channel name="Moments">

		<summer>
			<input>moments/fuselage_l-lbsft</input>
			<input>moments/cyclic_l-lbsft</input>
		
			<output>moments/l-lbsft</output>		
		</summer>

		<summer>
			<input>moments/fuselage_m-lbsft</input>									
			<input>moments/cyclic_m-lbsft</input>			

			<output>moments/m-lbsft</output>		
		</summer>

		<summer>
			<input>propulsion/engine[2]/rotor/n-lbsft</input>

			<output>moments/n-lbsft</output>		
		</summer>

	</channel>

</system>
