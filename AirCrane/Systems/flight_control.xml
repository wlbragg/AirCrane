<system name="flight_control">

	<!-- <property type="double" value="1">T4T/AGP/augmentation_factor</property>
	<property type="double" value="0">T4T/AGP/PID/collective/cmd-norm</property>

	<property type="double" value="0">T4T/AGP/trim</property>
	<property type="double" value="1">T4T/AGP/mode</property>
	<property type="double" value="1">T4T/AGP/mode-1</property>
	<property type="double" value="1">T4T/AGP/mode-1-pos</property>
	<property type="double" value="0">T4T/AGP/mode-2</property>
	<property type="double" value="0">T4T/AGP/mode-2-pos</property>
	<property type="double" value="0">T4T/AGP/mode-3</property>
	<property type="double" value="0">T4T/AGP/mode-3-pos</property>
	<property type="double" value="0">T4T/AGP/mode-4</property>
	<property type="double" value="0">T4T/AGP/mode-4-pos</property>
	<property type="double" value="0">T4T/AGP/mode-5</property>
	<property type="double" value="0">T4T/AGP/mode-5-pos</property>
	<property type="double" value="0">T4T/AGP/mode-6</property>
	<property type="double" value="0">T4T/AGP/mode-6-pos</property>
	<property type="double" value="0">T4T/AGP/PID/alt/error</property> -->

	<property type="double" value="0">fcs/collective-cmd-pos</property>
	<property type="double" value="0">fcs/cyclic_roll-cmd-pos</property>
	<property type="double" value="0">fcs/cyclic_pitch-cmd-pos</property>
	<property type="double" value="0">controls/electric/pitch-trim</property>
	<property type="double" value="0">fcs/rudder-cmd-pos</property>

	<property type="double" value="5">propulsion/engine[1]/rotor/cyclic_delta-deg</property>		
	<property type="double" value="1.5">propulsion/engine[1]/rotor/damping-factor</property>
	<property type="double" value="0">/controls/electric/AFCS/Manual</property>
	<property type="double" value="1">/controls/electric/AFCS/Active</property>	
	
	
	<channel name="initial">
	
	<!-- Interlocks -->
	
		<switch>
			<default value="/controls/electric/AFCS/Active"/>
			<test value="0">
				/controls/electric/AFCS/Manual eq 1
			</test>
			<output>/controls/electric/AFCS/Active</output>
		</switch>
		<switch>
			<default value="/controls/electric/AFCS/Manual"/>
			<test value="0">
				/controls/electric/AFCS/Active eq 1
			</test>
			<output>/controls/electric/AFCS/Manual</output>
		</switch>

		
	<!-- Rotor Brake -->

		<fcs_function>
			<function>	
				<ifthen>
					<eq>
						<property>/controls/electric/rotor_brake-sw</property>
						<value>1</value>
					</eq>
					<value>90</value>					
					<table>
						<independentVar>fcs/Helicopter/collective-pos-norm</independentVar>
						<tableData>
							0		-5
							1		8.645
						</tableData>
					</table>
				</ifthen>					
			</function>
			<output>propulsion/engine[1]/blade-angle</output>			
		</fcs_function>		
		<fcs_function>
			<function>						
				<table>
					<independentVar>fcs/Helicopter/collective-pos-norm</independentVar>
					<tableData>
						0		-5
						1		8.645
					</tableData>
				</table>				
			</function>
			<output>propulsion/engine[1]/rotor/blade-angle</output>			
		</fcs_function>
		
	<!-- Collective Adjust -->
	
		<fcs_function name="fcs/Helicopter/collective-cmd-norm">
			<function>				
				<product>
					<table>
						<independentVar>/controls/electric/hyd_utilities-psi</independentVar>
						<tableData>
							0	0
							13	1
						</tableData>
					</table>
					<table>
						<independentVar>fcs/collective-cmd-pos</independentVar>
						<tableData>
						-0.6		0
						0.6			1
						</tableData>
					</table>					
				</product>
			</function>
		</fcs_function>		
		
	<!-- Pitch Adjust -->
	
		<fcs_function name="fcs/Helicopter/cyclic_pitch-cmd-norm">
			<function>				
				<product>
					<table>
						<independentVar>/controls/electric/hyd_utilities-psi</independentVar>
						<tableData>
							0		0
							13		1
						</tableData>
					</table>
					<property>/controls/flight/elevator</property>			
				</product>
			</function>
		</fcs_function>
		
	<!-- Roll Adjust -->
	
		<fcs_function name="fcs/Helicopter/cyclic_roll-cmd-norm">
			<function>										
				<product>
					<table>
						<independentVar>/controls/electric/hyd_utilities-psi</independentVar>
						<tableData>
							0		0
							13		1
						</tableData>
					</table>
					<property>/controls/flight/aileron</property>	
				</product>
			</function>
		</fcs_function>
		
	<!-- Yaw Adjust -->

		<fcs_function name="fcs/Helicopter/pedals-cmd-norm">
			<function>									
				<product>
					<table>
						<independentVar>/controls/electric/hyd_utilities-psi</independentVar>
						<tableData>
							0		0
							13		1
						</tableData>
					</table>
					<property>/controls/flight/rudder</property>
				</product>
			</function>
			<clipto>						
				<min>-1</min>				
				<max>1</max>				
			</clipto>						
		</fcs_function>
		
	</channel>
		
	<channel name="Manual Control" execute="/controls/electric/AFCS/Manual">

		<summer>
			<input>fcs/Helicopter/collective-cmd-norm</input>
			<input></input>
			<output>fcs/Helicopter/manual_collective-cmd-norm</output>
		</summer>	
		
		<summer>
			<input>fcs/Helicopter/cyclic_pitch-cmd-norm</input>
			<input></input>
			<output>fcs/Helicopter/manual_pitch-cmd-norm</output>
		</summer>	
		
		<summer>
			<input>fcs/Helicopter/cyclic_roll-cmd-norm</input>
			<input></input>
			<output>fcs/Helicopter/manual_roll-cmd-norm</output>
		</summer>
		
		<summer>
			<input>fcs/Helicopter/pedals-cmd-norm</input>
			<input></input>
			<output>fcs/Helicopter/manual_pedals-cmd-norm</output>
		</summer>

	</channel>

	<property type="double" value="-0.016">/controls/electric/pitch-trim</property>	
	<property type="double" value="-0.007">/controls/electric/roll-trim</property>	
	
	<channel name="AFCS Control" execute="/controls/electric/AFCS/Active">

	<!-- Alt Adjust -->
	
		<summer>
			<input>fcs/Helicopter/collective-cmd-norm</input>
			<input></input>
			<output>fcs/Helicopter/manual_collective-cmd-norm</output>
		</summer>
	
	<!-- Pitch Adjust -->
	
	 	<fcs_function>
			<function>
				<ifthen>
					<eq>
						<p>/controls/electric/AFCS/trim-sw</p>
						<v>1</v>
					</eq>
					<sum>
	,					<property>-/controls/electric/pitch-trim</property>				
						<table>
							<independentVar>fcs/Helicopter/cyclic_pitch-cmd-norm</independentVar>
							<tableData>
								-1		0.174533 <!-- 5 degrees -->
								1		-0.174533
							</tableData>
						</table>
					</sum>
					<table>
						<independentVar>fcs/Helicopter/cyclic_pitch-cmd-norm</independentVar>
						<tableData>
							-1		0.174533
							1		-0.174533
						</tableData>
					</table>						
				</ifthen>
			</function>
			<clipto>
				<min>-0.174533</min>
				<max>0.174533</max>
			</clipto>
			<output>fcs/Helicopter/pitch_target-rad</output>
		</fcs_function>

		<summer>
			<input>attitude/pitch-rad</input>		
			<input>-fcs/Helicopter/pitch_target-rad</input>		
			<output>fcs/Helicopter/pitch_error-rad</output>
		</summer>
		
		<pure_gain> <!-- Rate of Change -->
			<input>fcs/Helicopter/pitch_error-rad</input>
			<gain>0.01</gain>
			<output>fcs/Helicopter/pitch_RoC-rad</output>
		</pure_gain>
		
		<pure_gain> <!-- Acceleration Damping -->
			<input>accelerations/qdot-rad_sec2</input>
			<gain>0.005</gain>
			<output>fcs/Helicopter/damping_RoC-q-fps2</output>
		</pure_gain>		
		
		<summer>
			<input>fcs/Helicopter/AFCS_pitch-cmd-norm</input>
			<input>fcs/Helicopter/pitch_RoC-rad</input>
			<input>fcs/Helicopter/damping_RoC-q-fps2</input>
			<clipto>
				<min>-1</min>
				<max>1</max>
			</clipto>			
			<output>fcs/Helicopter/AFCS_pitch-cmd-norm</output>
		</summer>

	<!-- Roll Adjust -->
	
	 	<fcs_function>
			<function>
				<ifthen>
					<eq>
						<p>/controls/electric/AFCS/trim-sw</p>
						<v>1</v>
					</eq>
					<sum>
	,					<property>/controls/electric/roll-trim</property>				
						<table>
							<independentVar>fcs/Helicopter/cyclic_roll-cmd-norm</independentVar>
							<tableData>
								-1		-0.174533 <!-- 5 degrees -->
								1		0.174533
							</tableData>
						</table>
					</sum>
					<table>
						<independentVar>fcs/Helicopter/cyclic_roll-cmd-norm</independentVar>
						<tableData>
							-1		-0.174533
							1		0.174533
						</tableData>
					</table>						
				</ifthen>
			</function>
			<clipto>
				<min>-0.174533</min>
				<max>0.174533</max>
			</clipto>
			<output>fcs/Helicopter/roll_target-rad</output>
		</fcs_function>
	
		<summer> <!-- error -->
			<input>fcs/Helicopter/roll_target-rad</input>		
			<input>-attitude/roll-rad</input>
			<output>fcs/Helicopter/roll_error-rad</output>
		</summer>
		
		<pure_gain> <!-- Rate of Change -->
			<input>fcs/Helicopter/roll_error-rad</input>
			<gain>0.01</gain>
			<output>fcs/Helicopter/roll_RoC-rad</output>
		</pure_gain>
		
		<pure_gain> <!-- Acceleration Damping -->
			<input>-accelerations/pdot-rad_sec2</input>
			<gain>0.005</gain>
			<output>fcs/Helicopter/damping_RoC-p-fps2</output>
		</pure_gain>
		
		<summer>
			<input>fcs/Helicopter/AFCS_roll-cmd-norm</input>
			<input>fcs/Helicopter/roll_RoC-rad</input>
			<input>fcs/Helicopter/damping_RoC-p-fps2</input>
			<clipto>
				<min>-1</min>
				<max>1</max>
			</clipto>			
			<output>fcs/Helicopter/AFCS_roll-cmd-norm</output>
		</summer>
		
	<!-- Yaw Adjust -->
	
	 	<fcs_function>
			<function>
				<ifthen>
					<eq>
						<p>/controls/electric/AFCS/trim-sw</p>
						<v>1</v>
					</eq>
					<sum>
	,					<property>/controls/electric/yaw-trim</property>				
						<table>
							<independentVar>fcs/Helicopter/pedals-cmd-norm</independentVar>
							<tableData>
								-1		-1.0
								1		1.0
							</tableData>
						</table>
					</sum>
					<ifthen>
						<lt>
							<p>/fdm/jsbsim/velocities/vtrue-kts</p>
							<v>25</v>
						</lt>
						<table>
							<independentVar>fcs/Helicopter/pedals-cmd-norm</independentVar>
							<tableData>
								-1		-1.0
								1		1.0
							</tableData>
						</table>
						<sum>
							<table>
								<independentVar>fcs/Helicopter/pedals-cmd-norm</independentVar>
								<tableData>
									-1		-1.0
									1		1.0
								</tableData>
							</table>
							<table>
								<independentVar>/fdm/jsbsim/aero/beta-deg</independentVar>
								<tableData>
									-30		-1.0
									30		1.0
								</tableData>
							</table>
						</sum>
					</ifthen>						
				</ifthen>
			</function>
			<clipto>
				<min>-1.0</min>
				<max>1.0</max>
			</clipto>
			<output>fcs/Helicopter/r_target-rad</output>
		</fcs_function>	

		<summer> <!-- error -->
			<input>fcs/Helicopter/r_target-rad</input>		
			<input>-velocities/r-rad_sec</input>
			<output>fcs/Helicopter/r_error-rad</output>
		</summer>		

		<pure_gain> <!-- Rate of Change -->
			<input>fcs/Helicopter/r_error-rad</input>
			<gain>0.01</gain>
			<output>fcs/Helicopter/rudder_RoC-rad</output>
		</pure_gain>
		
		<pure_gain> <!-- Acceleration Damping -->
			<input>-accelerations/rdot-rad_sec2</input>
			<gain>0.1</gain>
			<output>fcs/Helicopter/damping_RoC-r-rad2</output>
		</pure_gain>

		<summer>
			<input>fcs/Helicopter/AFCS_rudder-cmd-norm</input>		
			<input>fcs/Helicopter/rudder_RoC-rad</input>
			<input>fcs/Helicopter/damping_RoC-r-rad2</input>
			<clipto>
				<min>-1</min>
				<max>1</max>
			</clipto>
			<output>fcs/Helicopter/AFCS_rudder-cmd-norm</output>
		</summer>
		
	</channel>
		
	<channel name="Hover Assist" execute="/controls/electric/AFCS/bar_alt">
	
	<!-- Interlocks -->
	
		<summer>
			<input></input>
			<input></input>			
			<output>/controls/electric/AFCS/Active</output>
		</summer>	
	
	<!-- Alt Adjust -->
	
		<scheduled_gain>
			<input>T4T/one</input>
			<table>
				<independentVar>fcs/Helicopter/collective-cmd-norm</independentVar>
				<tableData>
					0		5
					1		-5
				</tableData>
			</table>
			<output>fcs/Helicopter/w_target-fps</output>
		</scheduled_gain>

		<summer> <!-- error -->
			<input>velocities/w-fps</input>		
			<input>-fcs/Helicopter/w_target-fps</input>
			<output>fcs/Helicopter/w_error-fps</output>
		</summer>
		
		<pure_gain> <!-- Rate of Change -->
			<input>fcs/Helicopter/w_error-fps</input>
			<gain>0.001</gain>
			<output>fcs/Helicopter/alt_RoC-fps</output>
		</pure_gain>
				
		<pure_gain> <!-- Acceleration Damping -->
			<input>accelerations/wdot-ft_sec2</input>
			<gain>0.001</gain>
			<output>fcs/Helicopter/damping_RoC-w-fps2</output>
		</pure_gain>
		
		<summer>
			<input>fcs/Helicopter/hover_alt-cmd-norm</input>		
			<input>fcs/Helicopter/alt_RoC-fps</input>
			<input>fcs/Helicopter/damping_RoC-w-fps2</input>
			<clipto>
				<min>-1</min>
				<max>1</max>
			</clipto>
			<output>fcs/Helicopter/hover_alt-cmd-norm</output>
		</summer>
		
	<!-- U-fps Adjust -->
	
		<scheduled_gain>
			<input>T4T/one</input>
			<table>
				<independentVar>fcs/Helicopter/cyclic_pitch-cmd-norm</independentVar>
				<tableData>
					-1		5
					1		-5
				</tableData>
			</table>
			<output>fcs/Helicopter/u_target-fps</output>
		</scheduled_gain>
		
		<summer> <!-- error -->
			<input>velocities/u-fps</input>		
			<input>-fcs/Helicopter/u_target-fps</input>		
			<output>fcs/Helicopter/u_error-fps</output>
		</summer>

		<pid> <!-- Rate of Change -->	
			<input>-fcs/Helicopter/u_error-fps</input>
			<kp>0.00002</kp>
			<ki>0</ki>
			<kd>0.00001</kd>
			<output>fcs/Helicopter/pitch_RoC-fps</output>
		</pid>		
	
		<pure_gain> <!-- Acceleration Damping -->
			<input>-accelerations/udot-ft_sec2</input>
			<gain>0.00001</gain>
			<output>fcs/Helicopter/damping_u-ft_sec2</output>
		</pure_gain>

		<summer>
			<input>fcs/Helicopter/hover_pitch-cmd-norm</input>		
			<input>fcs/Helicopter/pitch_RoC-fps</input>
			<input>fcs/Helicopter/damping_u-ft_sec2</input>
			<clipto>
				<min>-1</min>
				<max>1</max>
			</clipto>
			<output>fcs/Helicopter/hover_pitch-cmd-norm</output>
		</summer>
	
	<!-- v-fps Adjust -->
	
		<scheduled_gain>
			<input>T4T/one</input>
			<table>
				<independentVar>fcs/Helicopter/cyclic_roll-cmd-norm</independentVar>
				<tableData>
					-1		-5
					1		5
				</tableData>
			</table>
			<output>fcs/Helicopter/v_target-fps</output>
		</scheduled_gain>

		<summer> <!-- error -->
			<input>velocities/v-fps</input>		
			<input>-fcs/Helicopter/v_target-fps</input>		
			<output>fcs/Helicopter/v_error-fps</output>
		</summer>		

		<pid> <!-- Rate of Change -->
			<input>-fcs/Helicopter/v_error-fps</input>
			<kp>0.00002</kp>
			<ki>0</ki>
			<kd>0.00001</kd>
			<output>fcs/Helicopter/roll_RoC-fps</output>
		</pid>
		
		<pure_gain> <!-- Acceleration Damping -->
			<input>-accelerations/vdot-ft_sec2</input>
			<gain>0.00001</gain>
			<output>fcs/Helicopter/damping_v-ft_sec2</output>
		</pure_gain>		

		<summer>
			<input>fcs/Helicopter/hover_roll-cmd-norm</input>		
			<input>fcs/Helicopter/roll_RoC-fps</input>
			<input>fcs/Helicopter/damping_v-ft_sec2</input>
			<clipto>
				<min>-1</min>
				<max>1</max>
			</clipto>
			<output>fcs/Helicopter/hover_roll-cmd-norm</output>
		</summer>
		
	<!-- Yaw Adjust -->
	
		<scheduled_gain>
			<input>T4T/one</input>
			<table>
				<independentVar>fcs/Helicopter/pedals-cmd-norm</independentVar>
				<tableData>
					-1		-0.5
					1		0.5
				</tableData>
			</table>
			<output>fcs/Helicopter/r_target-rad</output>
		</scheduled_gain>

		<summer> <!-- error -->
			<input>fcs/Helicopter/r_target-rad</input>		
			<input>-velocities/r-rad_sec</input>
			<output>fcs/Helicopter/r_error-rad</output>
		</summer>		

		<pure_gain> <!-- Rate of Change -->
			<input>fcs/Helicopter/r_error-rad</input>
			<gain>0.01</gain>
			<output>fcs/Helicopter/rudder_RoC-rad</output>
		</pure_gain>
		
		<pure_gain> <!-- Acceleration Damping -->
			<input>-accelerations/rdot-rad_sec2</input>
			<gain>0.1</gain>
			<output>fcs/Helicopter/damping_RoC-r-rad2</output>
		</pure_gain>

		<summer>
			<input>fcs/Helicopter/AFCS_rudder-cmd-norm</input>		
			<input>fcs/Helicopter/rudder_RoC-rad</input>
			<input>fcs/Helicopter/damping_RoC-r-rad2</input>
			<clipto>
				<min>-1</min>
				<max>1</max>
			</clipto>
			<output>fcs/Helicopter/hover_rudder-cmd-norm</output>
		</summer>

		
	</channel>
	
	<channel name="Control">
	
	<!-- Alt Control -->
	
 		<fcs_function>
			<function>
				<ifthen>
					<eq>
						<p>/controls/electric/AFCS/Manual</p>
						<v>1</v>
					</eq>
					<p>fcs/Helicopter/manual_collective-cmd-norm</p>					
					<ifthen>
						<eq>
							<p>/controls/electric/AFCS/Active</p>
							<v>1</v>
						</eq>
						<p>fcs/Helicopter/manual_collective-cmd-norm</p>							
						<p>fcs/Helicopter/hover_alt-cmd-norm</p>						
					</ifthen>
				</ifthen>
			</function>
			<clipto>
				<min>0</min>
				<max>1</max>
			</clipto>
			<output>fcs/Helicopter/collective-pos-norm</output>
		</fcs_function>	
			
	<!-- Pitch Control -->

 		<fcs_function>
			<function>
				<ifthen>
					<eq>
						<p>/controls/electric/AFCS/Manual</p>
						<v>1</v>
					</eq>
					<p>fcs/Helicopter/manual_pitch-cmd-norm</p>					
					<ifthen>
						<eq>
							<p>/controls/electric/AFCS/Active</p>
							<v>1</v>
						</eq>
						<p>fcs/Helicopter/AFCS_pitch-cmd-norm</p>						
						<p>fcs/Helicopter/hover_pitch-cmd-norm</p>
					</ifthen>
				</ifthen>
			</function>
			<clipto>
				<min>-1</min>
				<max>1</max>
			</clipto>
			<output>fcs/Helicopter/cyclic_pitch-pos-norm</output>
		</fcs_function>
		
	<!-- Roll Control -->
	
 		<fcs_function>
			<function>
				<ifthen>
					<eq>
						<p>/controls/electric/AFCS/Manual</p>
						<v>1</v>
					</eq>
					<p>fcs/Helicopter/manual_roll-cmd-norm</p>					
					<ifthen>
						<eq>
							<p>/controls/electric/AFCS/Active</p>
							<v>1</v>
						</eq>
						<p>fcs/Helicopter/AFCS_roll-cmd-norm</p>						
						<p>fcs/Helicopter/hover_roll-cmd-norm</p>					
					</ifthen>
				</ifthen>
			</function>
			<clipto>
				<min>-1</min>
				<max>1</max>
			</clipto>
			<output>fcs/Helicopter/cyclic_roll-pos-norm</output>
		</fcs_function>
			
	<!-- Yaw Control -->
		
 		<fcs_function>
			<function>
				<ifthen>
					<eq>
						<p>/controls/electric/AFCS/Manual</p>
						<v>1</v>
					</eq>
					<p>fcs/Helicopter/manual_pedals-cmd-norm</p>
					<ifthen>					
						<eq>
							<p>/controls/electric/AFCS/Active</p>
							<v>1</v>
						</eq>					
						<p>fcs/Helicopter/AFCS_rudder-cmd-norm</p>					
						<p>fcs/Helicopter/hover_rudder-cmd-norm</p>	
					</ifthen>						
				</ifthen>
			</function>
			<clipto>
				<min>-1</min>
				<max>1</max>
			</clipto>
			<output>fcs/Helicopter/rudder-pos-norm</output>
		</fcs_function>
	
		<fcs_function name="propulsion/engine[2]/rotor/thrust_delta-lbs">
			<function>
				<table>
					<independentVar>fcs/Helicopter/rudder-pos-norm</independentVar>
					<tableData>
						-1		500
						1		-500
					</tableData>
				</table>
			</function>				
		</fcs_function>
		
	<!-- Blade incident Angle -->
	
		<fcs_function name="propulsion/engine[1]/rotor/east/blade-angle">
			<function>
				<sum>
					<property>propulsion/engine[1]/rotor/blade-angle</property>
					<product>
						<property>propulsion/engine[1]/rotor/cyclic_delta-deg</property>
						<table>
							<independentVar>fcs/Helicopter/cyclic_pitch-pos-norm</independentVar>
							<tableData>
								-1	1
								1	-1
							</tableData>
						</table>
					</product>
					<product>
						<property>velocities/q-rad_sec</property>	
						<property>-propulsion/engine[1]/rotor/damping-factor</property>
					</product>
				</sum>
			</function>
			<clipto>						
				<min>-5</min>				
				<max>8.645</max>				
			</clipto>							
		</fcs_function>
	
		<fcs_function name="propulsion/engine[1]/rotor/west/blade-angle">
			<function>
				<sum>
					<property>propulsion/engine[1]/rotor/blade-angle</property>
					<product>
						<property>propulsion/engine[1]/rotor/cyclic_delta-deg</property>
						<table>
							<independentVar>fcs/Helicopter/cyclic_pitch-pos-norm</independentVar>
							<tableData>
								-1	-1
								1	1
							</tableData>
						</table>
					</product>
					<product>
						<property>velocities/q-rad_sec</property>	
						<property>propulsion/engine[1]/rotor/damping-factor</property>
					</product>				
				</sum>
			</function>
			<clipto>						
				<min>-5</min>				
				<max>8.645</max>				
			</clipto>							
		</fcs_function>	
			
		<fcs_function name="propulsion/engine[1]/rotor/north/blade-angle">
			<function>
				<sum>
					<property>propulsion/engine[1]/rotor/blade-angle</property>
					<product>
						<property>propulsion/engine[1]/rotor/cyclic_delta-deg</property>
						<table>
							<independentVar>fcs/Helicopter/cyclic_roll-pos-norm</independentVar>
							<tableData>
								-1	-1
								1	1
							</tableData>
						</table>
					</product>
					<product>
						<property>velocities/p-rad_sec</property>	
						<property>-propulsion/engine[1]/rotor/damping-factor</property>
					</product>
				</sum>
			</function>
			<clipto>						
				<min>-5</min>				
				<max>8.645</max>				
			</clipto>							
		</fcs_function>
		
		<fcs_function name="propulsion/engine[1]/rotor/south/blade-angle">
			<function>
				<sum>
					<property>propulsion/engine[1]/rotor/blade-angle</property>
					<product>
						<property>propulsion/engine[1]/rotor/cyclic_delta-deg</property>
						<table>
							<independentVar>fcs/Helicopter/cyclic_roll-pos-norm</independentVar>
							<tableData>
								-1	1
								1	-1
							</tableData>
						</table>
					</product>
					<product>
						<property>velocities/p-rad_sec</property>	
						<property>propulsion/engine[1]/rotor/damping-factor</property>
					</product>
				</sum>
			</function>
			<clipto>						
				<min>-5</min>				
				<max>8.645</max>				
			</clipto>							
		</fcs_function>
		
	</channel>
	
	<channel name="huds">
	
	
 		<fcs_function>
			<function>
				<sum>
					<p>position/h-agl-ft</p>
					<v>-8.489</v>						
				</sum>
			</function>
			<output>/sim/hud/h-agl-ft</output>
		</fcs_function>	
	
	
	
 		<fcs_function>
			<function>
				<ifthen>
					<lt>
						<p>/sim/hud/flashing</p>
						<v>1</v>
					</lt>
					<sum>
						<v>0.01</v>
						<p>/sim/hud/flashing</p>						
					</sum>
					<v>0</v>					
				</ifthen>
			</function>
			<output>/sim/hud/flashing</output>
		</fcs_function>
	
 		<fcs_function>
			<function>
				<ifthen>
					<and>
						<eq>
							<p>/controls/electric/cab_power</p>
							<v>1</v>
						</eq>
						<eq>
							<p>gear/unit[0]/WOW</p>
							<v>1</v>
						</eq>
					</and>
					<v>4</v> <!-- ground hud -->
					<ifthen>
						<and>
							<eq>
								<p>/controls/electric/cab_power</p>
								<v>1</v>
							</eq>
							<eq>
								<p>/fdm/jsbsim/propulsion/engine[1]/rotor/vortex_ring</p>
								<v>1</v>
							</eq>
						</and>
						<ifthen>
							<eq>
								<p>/controls/electric/AFCS/Active</p>
								<v>1</v>
							</eq>
							<v>3</v> <!-- AFCS hud -->
							<ifthen>
								<eq>
									<p>/controls/electric/AFCS/bar_alt</p>
									<v>1</v>
								</eq>
								<v>4</v> <!-- Bar Alt hud -->
								<v>2</v> <!-- Manual hud -->
							</ifthen>						
						</ifthen>						
						<ifthen>
							<lt>
								<p>/fdm/jsbsim/propulsion/engine[1]/rotor/vortex_ring</p>
								<v>1</v>
							</lt>
							<v>5</v> <!-- Vortex Ring State -->
							<v>0</v>
						</ifthen>							
					</ifthen>					
				</ifthen>
			</function>
			<output>/sim/hud/current-path</output>
		</fcs_function>
		
 		<fcs_function>
			<function>
				<ifthen>
					<eq>
						<p>/sim/hud/current-path</p>
						<v>5</v>
					</eq>
					<v>1</v> <!-- red -->
					<v>0</v> <!-- green -->
				</ifthen>
			</function>
			<output>/sim/hud/current-color</output>
		</fcs_function>
		
	</channel>
	
</system>
			