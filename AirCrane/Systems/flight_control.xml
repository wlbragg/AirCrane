**************************************************************************


Vectors along the axis
x = u
y = v
z = w
Rotation around the axis
x = p
y = q
z = r
Moments around the axis
x = l
y = m
z = n

engine[0] = APP
engine[1] = Main Rotor
engine[2] = Tail Rotor
engine[3] = Turbine No.1
engine[4] = Turbine No.2

-->

<system name="flight_control">

	<property type="double" value="0">fcs/collective-cmd-pos</property>
	<property type="double" value="0">fcs/cyclic_roll-cmd-pos</property>
	<property type="double" value="0">fcs/cyclic_pitch-cmd-pos</property>
	<property type="double" value="0">fcs/rudder-cmd-pos</property>

	<property type="double" value="5">propulsion/engine[1]/rotor/cyclic_delta-deg</property>		
	<property type="double" value="1.5">propulsion/engine[1]/rotor/damping-factor</property>
	
	<channel name="initial">
	
	<!-- Rotor Brake -->

		<fcs_function>
			<function>	
				<ifthen>
					<eq>
						<property>/controls/electric/rotor_brake-sw</property>
						<value>1</value>
					</eq>
					<value>90</value>					
					<table>
						<independentVar>fcs/Helicopter/collective-pos-norm</independentVar>
						<tableData>
							0		-5
							1		8.645
						</tableData>
					</table>
				</ifthen>					
			</function>
			<output>propulsion/engine[1]/blade-angle</output>			
		</fcs_function>		
		<fcs_function>
			<function>						
				<table>
					<independentVar>fcs/Helicopter/collective-pos-norm</independentVar>
					<tableData>
						0		-5
						1		8.645
					</tableData>
				</table>				
			</function>
			<output>propulsion/engine[1]/rotor/blade-angle</output>			
		</fcs_function>
		
	<!-- Collective Adjust -->
	
		<fcs_function name="fcs/Helicopter/collective-cmd-norm">
			<function>				
				<product>
					<table>
						<independentVar>/controls/electric/hyd_utilities-psi</independentVar>
						<tableData>
							0	0
							13	1
						</tableData>
					</table>
					<table>
						<independentVar>fcs/collective-cmd-pos</independentVar>
						<tableData>
						-0.6		0
						0.6			1
						</tableData>
					</table>					
				</product>
			</function>
		</fcs_function>		
		
	<!-- Pitch Adjust -->
	
		<fcs_function name="fcs/Helicopter/cyclic_pitch-cmd-norm">
			<function>				
				<product>
					<table>
						<independentVar>/controls/electric/hyd_utilities-psi</independentVar>
						<tableData>
							0		0
							13		1
						</tableData>
					</table>
					<property>/controls/flight/elevator</property>			
				</product>
			</function>
		</fcs_function>
		
	<!-- Roll Adjust -->
	
		<fcs_function name="fcs/Helicopter/cyclic_roll-cmd-norm">
			<function>										
				<product>
					<table>
						<independentVar>/controls/electric/hyd_utilities-psi</independentVar>
						<tableData>
							0		0
							13		1
						</tableData>
					</table>
					<property>/controls/flight/aileron</property>	
				</product>
			</function>
		</fcs_function>
		
	<!-- Yaw Adjust -->

		<fcs_function name="fcs/Helicopter/pedals-cmd-norm">
			<function>									
				<product>
					<table>
						<independentVar>/controls/electric/hyd_utilities-psi</independentVar>
						<tableData>
							0		0
							13		1
						</tableData>
					</table>
					<property>/controls/flight/rudder</property>
				</product>
			</function>
			<clipto>						
				<min>-1</min>				
				<max>1</max>				
			</clipto>						
		</fcs_function>
		
	<!-- Interlocks -->
		
 		<fcs_function>
			<function>
				<ifthen>
					<lt>
						<p>/fdm/jsbsim/propulsion/engine[1]/rotor/vortex_ring</p>
						<v>1</v>
					</lt>
					<v>1</v>
					<p>/controls/electric/AFCS/Manual</p>
				</ifthen>
			</function>
			<output>/controls/electric/AFCS/Manual</output>
		</fcs_function>		
 		<fcs_function>
			<function>
				<ifthen>
					<lt>
						<p>/fdm/jsbsim/propulsion/engine[1]/rotor/vortex_ring</p>
						<v>1</v>
					</lt>
					<v>0</v>					
					<p>/controls/electric/AFCS/Active</p>					
				</ifthen>
			</function>
			<output>/controls/electric/AFCS/Active</output>
		</fcs_function>			
 		<fcs_function>
			<function>
				<ifthen>
					<lt>
						<p>/controls/electric/AFCS/Active</p>
						<v>1</v>
					</lt>
					<v>0</v>						
					<p>/controls/electric/AFCS/bar_alt</p>														
				</ifthen>
			</function>
			<output>/controls/electric/AFCS/bar_alt</output>
		</fcs_function>			
		
	</channel>
		
	<channel name="Manual Control" execute="/controls/electric/AFCS/Manual">

		<summer>
			<input>fcs/Helicopter/collective-cmd-norm</input>
			<input></input>
			<output>fcs/Helicopter/manual_collective-cmd-norm</output>
		</summer>	
		
		<summer>
			<input>fcs/Helicopter/cyclic_pitch-cmd-norm</input>
			<input></input>
			<output>fcs/Helicopter/manual_pitch-cmd-norm</output>
		</summer>	
		
		<summer>
			<input>fcs/Helicopter/cyclic_roll-cmd-norm</input>
			<input></input>
			<output>fcs/Helicopter/manual_roll-cmd-norm</output>
		</summer>
		
		<summer>
			<input>fcs/Helicopter/pedals-cmd-norm</input>
			<input></input>
			<output>fcs/Helicopter/manual_pedals-cmd-norm</output>
		</summer>

	</channel>
	
	<channel name="AFCS Control" execute="/controls/electric/AFCS/Active">
		
	<!-- Alt Adjust -->
	
 		<fcs_function>
			<function>
				<ifthen>
					<eq>
						<p>/controls/electric/AFCS/bar_alt</p>
						<v>1</v>
					</eq>
					<table>
						<independentVar>fcs/Helicopter/bar_alt_error-ft</independentVar>
						<tableData>
							-100	-5
							100		5
						</tableData>
					</table>
					<table>
						<independentVar>fcs/Helicopter/collective-cmd-norm</independentVar>
						<tableData>
							0		5
							1		-5
						</tableData>
					</table>
				</ifthen>
			</function>
			<output>fcs/Helicopter/w_target-fps</output>
		</fcs_function>

		<summer> <!-- error -->
			<input>velocities/w-fps</input>		
			<input>-fcs/Helicopter/w_target-fps</input>
			<output>fcs/Helicopter/w_error-fps</output>
		</summer>
		
		<pure_gain> <!-- Rate of Change -->
			<input>fcs/Helicopter/w_error-fps</input>
			<gain>0.001</gain>
			<output>fcs/Helicopter/alt_RoC-fps</output>
		</pure_gain>
				
		<pure_gain> <!-- Acceleration Damping -->
			<input>accelerations/wdot-ft_sec2</input>
			<gain>0.001</gain>
			<output>fcs/Helicopter/damping_RoC-w-fps2</output>
		</pure_gain>
		
		<summer>
			<input>fcs/Helicopter/AFCS_alt-cmd-norm</input>		
			<input>fcs/Helicopter/alt_RoC-fps</input>
			<input>fcs/Helicopter/damping_RoC-w-fps2</input>
			<clipto>
				<min>-1</min>
				<max>1</max>
			</clipto>
			<output>fcs/Helicopter/AFCS_alt-cmd-norm</output>
		</summer>
		
		<switch>
			<default value="/sim/hud/h-agl-ft"/>
			<test value="fcs/Helicopter/bar_alt-cmd">
				/controls/electric/AFCS/bar_alt eq 1
			</test>
			<output>fcs/Helicopter/bar_alt-cmd</output>
		</switch>	
	
	<!-- Pitch Adjust -->
	
		<scheduled_gain>
			<input>T4T/one</input>
			<table>
				<independentVar>fcs/Helicopter/cyclic_pitch-cmd-norm</independentVar>
				<tableData>
					-1		0.087266
					1		-0.087266
				</tableData>
			</table>
			<output>fcs/Helicopter/pitch_target-rad</output>
		</scheduled_gain>

		<summer>
			<input>attitude/pitch-rad</input>			
			<input>-fcs/Helicopter/pitch_target-rad</input>		
			<output>fcs/Helicopter/pitch_error-rad</output>
		</summer>
		
		<pure_gain> <!-- Rate of Change -->
			<input>fcs/Helicopter/pitch_error-rad</input>
			<gain>0.01</gain>
			<output>fcs/Helicopter/pitch_RoC-rad</output>
		</pure_gain>
		
		<pure_gain> <!-- Acceleration Damping -->
			<input>accelerations/qdot-rad_sec2</input>
			<gain>0.005</gain>
			<output>fcs/Helicopter/damping_RoC-q-fps2</output>
		</pure_gain>		
		
		<summer>
			<input>fcs/Helicopter/AFCS_pitch-cmd-norm</input>
			<input>fcs/Helicopter/pitch_RoC-rad</input>
			<input>fcs/Helicopter/damping_RoC-q-fps2</input>
			<clipto>
				<min>-1</min>
				<max>1</max>
			</clipto>			
			<output>fcs/Helicopter/AFCS_pitch-cmd-norm</output>
		</summer>

	<!-- Roll Adjust -->
	
		<scheduled_gain>
			<input>T4T/one</input>
			<table>
				<independentVar>fcs/Helicopter/cyclic_roll-cmd-norm</independentVar>
				<tableData>
					-1		-0.087266
					1		0.087266
				</tableData>
			</table>
			<output>fcs/Helicopter/roll_target-rad</output>
		</scheduled_gain>

		<summer> <!-- error -->
			<input>fcs/Helicopter/roll_target-rad</input>		
			<input>-attitude/roll-rad</input>
			<output>fcs/Helicopter/roll_error-rad</output>
		</summer>
		
		<pure_gain> <!-- Rate of Change -->
			<input>fcs/Helicopter/roll_error-rad</input>
			<gain>0.01</gain>
			<output>fcs/Helicopter/roll_RoC-rad</output>
		</pure_gain>
		
		<pure_gain> <!-- Acceleration Damping -->
			<input>-accelerations/pdot-rad_sec2</input>
			<gain>0.005</gain>
			<output>fcs/Helicopter/damping_RoC-p-fps2</output>
		</pure_gain>
		
		<summer>
			<input>fcs/Helicopter/AFCS_roll-cmd-norm</input>
			<input>fcs/Helicopter/roll_RoC-rad</input>
			<input>fcs/Helicopter/damping_RoC-p-fps2</input>
			<clipto>
				<min>-1</min>
				<max>1</max>
			</clipto>			
			<output>fcs/Helicopter/AFCS_roll-cmd-norm</output>
		</summer>
		
	<!-- Yaw Adjust -->
	
		<scheduled_gain>
			<input>T4T/one</input>
			<table>
				<independentVar>fcs/Helicopter/pedals-cmd-norm</independentVar>
				<tableData>
					-1		-0.5
					1		0.5
				</tableData>
			</table>
			<output>fcs/Helicopter/r_target-rad</output>
		</scheduled_gain>

		<summer> <!-- error -->
			<input>fcs/Helicopter/r_target-rad</input>		
			<input>-velocities/r-rad_sec</input>
			<output>fcs/Helicopter/r_error-rad</output>
		</summer>		

		<pure_gain> <!-- Rate of Change -->
			<input>fcs/Helicopter/r_error-rad</input>
			<gain>0.01</gain>
			<output>fcs/Helicopter/rudder_RoC-rad</output>
		</pure_gain>
		
		<pure_gain> <!-- Acceleration Damping -->
			<input>-accelerations/rdot-rad_sec2</input>
			<gain>0.1</gain>
			<output>fcs/Helicopter/damping_RoC-r-rad2</output>
		</pure_gain>

		<summer>
			<input>fcs/Helicopter/AFCS_rudder-cmd-norm</input>		
			<input>fcs/Helicopter/rudder_RoC-rad</input>
			<input>fcs/Helicopter/damping_RoC-r-rad2</input>
			<clipto>
				<min>-1</min>
				<max>1</max>
			</clipto>
			<output>fcs/Helicopter/AFCS_rudder-cmd-norm</output>
		</summer>
		
	</channel>
		
	<channel name="Bar Alt" execute="/controls/electric/AFCS/bar_alt">

		<scheduled_gain>
			<input>T4T/one</input>
			<table>
				<independentVar>fcs/Helicopter/collective-cmd-norm</independentVar>
				<tableData>
					0		-0.1
					1		0.1
				</tableData>
			</table>
			<output>fcs/Helicopter/bar_alt-adjustment</output>
		</scheduled_gain>
		
		<summer>
			<input>fcs/Helicopter/bar_alt-cmd</input>		
			<input>fcs/Helicopter/bar_alt-adjustment</input>
			<output>fcs/Helicopter/bar_alt-cmd</output>
			<clipto>
				<min>0</min>
				<max>100000</max>
			</clipto>
		</summer>
		
		<summer> <!-- error -->
			<input>/sim/hud/h-agl-ft</input>		
			<input>-fcs/Helicopter/bar_alt-cmd</input>
			<output>fcs/Helicopter/bar_alt_error-ft</output>
		</summer>
		
		<pure_gain> <!-- Rate of Change -->
			<input>-fcs/Helicopter/bar_alt_error-ft</input>
			<gain>0.001</gain>
			<output>fcs/Helicopter/bar_alt_RoC-ft</output>
		</pure_gain>
		
		<pure_gain> <!-- Acceleration Damping -->
			<input>accelerations/wdot-ft_sec2</input>
			<gain>0.001</gain>
			<output>fcs/Helicopter/damping_RoC-w-fps2</output>
		</pure_gain>
		
		<summer>
			<input>fcs/Helicopter/bar_alt-cmd-norm</input>		
			<input>fcs/Helicopter/bar_alt_RoC-ft</input>
			<input>fcs/Helicopter/damping_RoC-w-fps2</input>
			<clipto>
				<min>-1</min>
				<max>1</max>
			</clipto>
			<output>fcs/Helicopter/bar_alt-cmd-norm</output>
		</summer>
		


	</channel>
	
	<channel name="Control">
	
	<!-- Alt Control -->
	
 		<fcs_function>
			<function>					
				<ifthen>
					<eq>
						<p>/controls/electric/AFCS/Active</p>
						<v>1</v>
					</eq>
					<ifthen>
						<eq>
							<p>/controls/electric/AFCS/bar_alt</p>
							<v>1</v>
						</eq>
						<sum>
							<p>fcs/Helicopter/bar_alt-cmd-norm</p>
							<p>fcs/Helicopter/AFCS_alt-cmd-norm</p>
						</sum>
						<p>fcs/Helicopter/AFCS_alt-cmd-norm</p>						
					</ifthen>
					<p>fcs/Helicopter/manual_collective-cmd-norm</p>
				</ifthen>
			</function>
			<clipto>
				<min>0</min>
				<max>1</max>
			</clipto>
			<output>fcs/Helicopter/collective-pos-norm</output>
		</fcs_function>	
			
	<!-- Pitch Control -->

 		<fcs_function>
			<function>
				<ifthen>
					<eq>
						<p>/controls/electric/AFCS/Manual</p>
						<v>1</v>
					</eq>
					<p>fcs/Helicopter/manual_pitch-cmd-norm</p>					
					<ifthen>
						<eq>
							<p>/controls/electric/AFCS/Active</p>
							<v>1</v>
						</eq>
						<p>fcs/Helicopter/AFCS_pitch-cmd-norm</p>						
						<p>fcs/Helicopter/hover_pitch-cmd-norm</p>
					</ifthen>
				</ifthen>
			</function>
			<clipto>
				<min>-1</min>
				<max>1</max>
			</clipto>
			<output>fcs/Helicopter/cyclic_pitch-pos-norm</output>
		</fcs_function>
		
	<!-- Roll Control -->
	
 		<fcs_function>
			<function>
				<ifthen>
					<eq>
						<p>/controls/electric/AFCS/Manual</p>
						<v>1</v>
					</eq>
					<p>fcs/Helicopter/manual_roll-cmd-norm</p>					
					<ifthen>
						<eq>
							<p>/controls/electric/AFCS/Active</p>
							<v>1</v>
						</eq>
						<p>fcs/Helicopter/AFCS_roll-cmd-norm</p>						
						<p>fcs/Helicopter/hover_roll-cmd-norm</p>					
					</ifthen>
				</ifthen>
			</function>
			<clipto>
				<min>-1</min>
				<max>1</max>
			</clipto>
			<output>fcs/Helicopter/cyclic_roll-pos-norm</output>
		</fcs_function>
			
	<!-- Yaw Control -->
		
 		<fcs_function>
			<function>
				<ifthen>
					<eq>
						<p>/controls/electric/AFCS/Manual</p>
						<v>1</v>
					</eq>
					<p>fcs/Helicopter/manual_pedals-cmd-norm</p>
					<ifthen>					
						<eq>
							<p>/controls/electric/AFCS/Active</p>
							<v>1</v>
						</eq>					
						<p>fcs/Helicopter/AFCS_rudder-cmd-norm</p>					
						<p>fcs/Helicopter/hover_rudder-cmd-norm</p>	
					</ifthen>						
				</ifthen>
			</function>
			<clipto>
				<min>-1</min>
				<max>1</max>
			</clipto>
			<output>fcs/Helicopter/rudder-pos-norm</output>
		</fcs_function>
	
		<fcs_function name="propulsion/engine[2]/rotor/thrust_delta-lbs">
			<function>
				<table>
					<independentVar>fcs/Helicopter/rudder-pos-norm</independentVar>
					<tableData>
						-1		500
						1		-500
					</tableData>
				</table>
			</function>				
		</fcs_function>
		
	<!-- Blade incident Angle -->
	
		<fcs_function name="propulsion/engine[1]/rotor/east/blade-angle">
			<function>
				<sum>
					<property>propulsion/engine[1]/rotor/blade-angle</property>
					<product>
						<property>propulsion/engine[1]/rotor/cyclic_delta-deg</property>
						<table>
							<independentVar>fcs/Helicopter/cyclic_pitch-pos-norm</independentVar>
							<tableData>
								-1	1
								1	-1
							</tableData>
						</table>
					</product>
					<product>
						<property>velocities/q-rad_sec</property>	
						<property>-propulsion/engine[1]/rotor/damping-factor</property>
					</product>
				</sum>
			</function>
			<clipto>						
				<min>-5</min>				
				<max>8.645</max>				
			</clipto>							
		</fcs_function>
	
		<fcs_function name="propulsion/engine[1]/rotor/west/blade-angle">
			<function>
				<sum>
					<property>propulsion/engine[1]/rotor/blade-angle</property>
					<product>
						<property>propulsion/engine[1]/rotor/cyclic_delta-deg</property>
						<table>
							<independentVar>fcs/Helicopter/cyclic_pitch-pos-norm</independentVar>
							<tableData>
								-1	-1
								1	1
							</tableData>
						</table>
					</product>
					<product>
						<property>velocities/q-rad_sec</property>	
						<property>propulsion/engine[1]/rotor/damping-factor</property>
					</product>				
				</sum>
			</function>
			<clipto>						
				<min>-5</min>				
				<max>8.645</max>				
			</clipto>							
		</fcs_function>	
			
		<fcs_function name="propulsion/engine[1]/rotor/north/blade-angle">
			<function>
				<sum>
					<property>propulsion/engine[1]/rotor/blade-angle</property>
					<product>
						<property>propulsion/engine[1]/rotor/cyclic_delta-deg</property>
						<table>
							<independentVar>fcs/Helicopter/cyclic_roll-pos-norm</independentVar>
							<tableData>
								-1	-1
								1	1
							</tableData>
						</table>
					</product>
					<product>
						<property>velocities/p-rad_sec</property>	
						<property>-propulsion/engine[1]/rotor/damping-factor</property>
					</product>
				</sum>
			</function>
			<clipto>						
				<min>-5</min>				
				<max>8.645</max>				
			</clipto>							
		</fcs_function>
		
		<fcs_function name="propulsion/engine[1]/rotor/south/blade-angle">
			<function>
				<sum>
					<property>propulsion/engine[1]/rotor/blade-angle</property>
					<product>
						<property>propulsion/engine[1]/rotor/cyclic_delta-deg</property>
						<table>
							<independentVar>fcs/Helicopter/cyclic_roll-pos-norm</independentVar>
							<tableData>
								-1	1
								1	-1
							</tableData>
						</table>
					</product>
					<product>
						<property>velocities/p-rad_sec</property>	
						<property>propulsion/engine[1]/rotor/damping-factor</property>
					</product>
				</sum>
			</function>
			<clipto>						
				<min>-5</min>				
				<max>8.645</max>				
			</clipto>							
		</fcs_function>
		
	</channel>

	<channel name="Huds">
	
 		<fcs_function>
			<function>
					<table>
						<independentVar>/controls/electric/pitch-trim</independentVar>
						<tableData>
							-0.087266	-360
							0.087266	360
						</tableData>
					</table>	
			</function>
			<output>/sim/hud/trim-pitch</output>
		</fcs_function>
 		<fcs_function>
