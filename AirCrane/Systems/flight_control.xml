	<property type="double" value="0">fcs/collective-cmd-pos</property>
	<property type="double" value="0">fcs/cyclic_roll-cmd-pos</property>
	<property type="double" value="0">fcs/cyclic_pitch-cmd-pos</property>
	<property type="double" value="0">fcs/rudder-cmd-pos</property>

	<channel name="Flight">

	<!-- Collective Adjust -->

		<scheduled_gain>
			<input>T4T/one</input>
			<table>
				<independentVar>fcs/collective-cmd-pos</independentVar>
				<tableData>
				-0.6		-5
				0.6			8.645
				</tableData>
			</table>
			<output>propulsion/engine[1]/blade-angle</output>
		</scheduled_gain>

	<!-- Roll Adjust -->

		<scheduled_gain>
			<input>T4T/one</input>
			<table>
				<independentVar>fcs/cyclic_roll-cmd-pos</independentVar>
				<tableData>
					-1		12
					1		-12
				</tableData>
			</table>
			<output>external_reactions/rotor_main/cyclic_roll-in</output>
		</scheduled_gain>

	<!-- Pitch Adjust -->

		<scheduled_gain>
			<input>T4T/one</input>
			<table>
				<independentVar>fcs/cyclic_pitch-cmd-pos</independentVar>
				<tableData>
					-1		-12
					1		12
				</tableData>
			</table>
			<output>external_reactions/rotor_main/cyclic_pitch-in</output>
		</scheduled_gain>

	<!-- Anti-Torque Adjust -->
	
		<scheduled_gain>
			<input>T4T/one</input>
			<table>
				<independentVar>fcs/rudder-cmd-pos</independentVar>
				<tableData>
					-1		-10
					1		10
				</tableData>
			</table>
			<output>propulsion/engine[2]/rotor/torque-target</output>
		</scheduled_gain>	
	
	</channel>



</system>
			