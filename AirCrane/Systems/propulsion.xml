<system name="Engine">


<property type="double" value="1">T4T/one</property>
<property type="double" value="1">T4T/AGP/augmentation_factor</property>

	<channel name="Rotor Power demand">

		<fcs_function name="propulsion/Power-hp">
			<function>
				<sum>
					<product>		<!-- main rotor gearbox losses -->
						<value>1.1364</value>
						<property>propulsion/engine[1]/power-hp</property>
					</product>
					<product>		<!-- tail rotor gearbox+drivetrain losses -->
						<value>1.25</value>
						<property>propulsion/engine[2]/power-hp</property>
					</product>
				</sum>
			</function>
		</fcs_function>

		<fcs_function name="propulsion/gearbox/engine_1-hp">
			<function>
				<product>
					<property>propulsion/Power-hp</property>
					<table>
						<independentVar lookup="row">propulsion/gearbox/engine_1-clutch</independentVar>
						<independentVar lookup="column">propulsion/gearbox/engine_2-clutch</independentVar>
						<tableData>
								0	1
							0	0	0
							1	1	0.5
						</tableData>
					</table>
				</product>
			</function>
		</fcs_function>

		<fcs_function name="propulsion/gearbox/engine_2-hp">
			<function>
				<product>
					<property>propulsion/Power-hp</property>
					<table>
						<independentVar lookup="row">propulsion/gearbox/engine_1-clutch</independentVar>
						<independentVar lookup="column">propulsion/gearbox/engine_2-clutch</independentVar>
						<tableData>
								0	1
							0	0	1
							1	0	0.5
						</tableData>
					</table>
				</product>
			</function>
		</fcs_function>

	</channel>

<property type="double" value="0">propulsion/engine[3]/governor/n1-lever</property>

	<channel name="Engine Management No.1">

<!--   engine[3] = Turbine No.1   -->

<!--
0.1	3780rpm
0.2	4360
0.3	4940
0.4	5520
0.5	6100
0.6	6685
0.7	7263
0.8	7835
0.9	8420
1.0 9000
-->

		<fcs_function>
			<function>
				<ifthen>
					<eq>
						<property>propulsion/engine[3]/set-running</property>
						<value>1</value>
					</eq>
					<value>1</value>
					<value>0</value>
				</ifthen>
			</function>
			<output>propulsion/engine[3]/constant-speed-mode</output>
		</fcs_function>
		<fcs_function>
			<function>
				<ifthen>
					<eq>
						<property>propulsion/engine[3]/constant-speed-mode</property>
						<value>1</value>
					</eq>
					<property>propulsion/engine[3]/blade-angle</property>
					<value>90</value>
				</ifthen>
			</function>
			<output>propulsion/engine[3]/blade-angle</output>
		</fcs_function>

		<kinematic>
			<input>propulsion/engine[3]/governor/n1-lever</input>
			<traverse>
				<setting>
					<position>0</position>
					<time>0</time>
				</setting>
				<setting>
					<position>0.1</position>
					<time>5</time>
				</setting>
				<setting>
					<position>0.6</position>
					<time>20</time>
				</setting>
				<setting>
					<position>1.0</position>
					<time>80</time>
				</setting>
			</traverse>
			<output>propulsion/engine[3]/governor/n1-pos</output>
		</kinematic>

		<fcs_function>
			<function>
				<table>
					<independentVar>propulsion/engine[3]/governor/n1-pos</independentVar>
					<tableData>
						0	0
						0.1	0.42
						1	1
					</tableData>
				</table>
			</function>
			<output>/controls/engines/engine[3]/propeller-pitch</output>
		</fcs_function>

		<fcs_function>
			<function>
				<max>
					<table>
						<independentVar>propulsion/engine[3]/engine-rpm</independentVar>
						<tableData>
							0		0
							12650	1500
						</tableData>
					</table>
					<property>propulsion/gearbox/engine_1-hp</property>
				</max>
			</function>
			<output>propulsion/engine[3]/governor/cmd-hp</output>
		</fcs_function>

		<fcs_function name="propulsion/engine[3]/governor/error-hp">
			<function>
				<sum>
					<property>propulsion/engine[3]/governor/cmd-hp</property>
					<property>-propulsion/engine[3]/power-hp</property>
				</sum>
			</function>
		</fcs_function>

		<pid>
			<input>propulsion/engine[3]/governor/error-hp</input>
			<kp>0.0000005</kp>
			<ki>0.0</ki>
			<kd>0.000001</kd>
			<output>propulsion/engine[3]/governor/output-hp</output>
		</pid>

		<summer>
			<input>/controls/engines/engine[3]/throttle</input>
			<input>propulsion/engine[3]/governor/output-hp</input>
			<output>/controls/engines/engine[3]/throttle</output>
		</summer>

<!-- CLUTCH -->

		<scheduled_gain name="propulsion/gearbox/engine_1-rpm">
			<input>propulsion/engine[3]/engine-rpm</input>
			<gain>propulsion/gearbox/ratio</gain>
			<table name="propulsion/gearbox/engine_1-clutch"> <!-- Clutch Engagement -->
				<independentVar>propulsion/engine[3]/engine-rpm</independentVar>
				<tableData>
					6840	0
					6945	0.01
					7050	0.02
					7155	0.04
					7260	0.07
					7365	0.11
					7470	0.15
					7575	0.2
					7680	0.26
					7785	0.35
					7890	0.5
					7995	0.7
					8100	1
				</tableData>
			</table>
		</scheduled_gain>

		<fcs_function name="propulsion/engine[3]/torque-lbsft">
			<function>
					<quotient>
						<property>propulsion/gearbox/engine_1-hp</property>
						<product>
							<value>0.0001904</value> <!-- 1/5252 -->
							<sum>
								<property>propulsion/engine[3]/engine-rpm</property>
								<value>0.0001</value>
							</sum>
						</product>
					</quotient>
			</function>
		</fcs_function>

	</channel>

<property type="double" value="0">propulsion/engine[4]/governor/n1-lever</property>

