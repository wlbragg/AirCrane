			</clipto>				
		</fcs_function>																		
																				
		<fcs_function name="propulsion/engine[1]/rotor/blade_3/blade-angle">																		
			<function>																	
				<sum>																
					<property>propulsion/engine[1]/rotor/blade-angle</property>															
					<product>															
						<sin>														
							<property>propulsion/engine[1]/rotor/blade_3/rotation-rad</property>													
						</sin>														
						<table>														
							<independentVar>fcs/Helicopter/cyclic_roll-cmd-norm</independentVar>													
