								<tableData>
									-1	0.174533
									1	-0.174533
								</tableData>
							</table>						
						</product>							
					</sum>
				</todegrees>
			</function>
		</fcs_function>		
		
		<fcs_function name="propulsion/engine[1]/rotor/blade_6-angle">
			<function>
				<todegrees>
					<sum>
						<toradians>
							<property>propulsion/engine[1]/blade-angle</property>
						</toradians>
						<product>
							<sin>
								<property>propulsion/engine[1]/rotor/blade_6-rad</property>					
							</sin>
							<table>
								<independentVar>fcs/cyclic_roll-cmd-pos</independentVar>
								<tableData>
									-1	-0.174533
									1	0.174533
								</tableData>
							</table>						
						</product>
						<product>
							<cos>
								<property>propulsion/engine[1]/rotor/blade_6-rad</property>					
							</cos>
							<table>
								<independentVar>fcs/cyclic_pitch-cmd-pos</independentVar>
								<tableData>
									-1	0.174533
									1	-0.174533
								</tableData>
							</table>						
						</product>							
					</sum>
				</todegrees>
			</function>
		</fcs_function>			
					
	</channel>

	<channel name="Tail Rotor">

<!--   engine[2] = Tail Rotor   -->

	<!-- rpm -->

		<fcs_function name="propulsion/engine[2]/governor/cmd-rpm">
			<function>
				<product>
					<value>4.59</value> <!-- 850/185 -->
					<property>propulsion/engine[1]/engine-rpm</property>
				</product>
			</function>
		</fcs_function>

		<summer name="propulsion/engine[2]/governor/error-rpm">
			<input>propulsion/engine[2]/engine-rpm</input>
			<input>-propulsion/engine[2]/governor/cmd-rpm</input>
		</summer>

		<pid>
			<input>-propulsion/engine[2]/governor/error-rpm</input>
			<kp>0.0001</kp>
			<ki>0.0</ki>
			<kd>0.0001</kd>
			<output>propulsion/engine[2]/governor/output-rpm</output>
		</pid>

		<summer>
			<input>/controls/engines/engine[2]/throttle</input>
			<input>propulsion/engine[2]/governor/output-rpm</input>
			<output>/controls/engines/engine[2]/throttle</output>
		</summer>
		
	<!-- Torque Management -->	

		<summer name="propulsion/engine[2]/rotor/torque-error">
			<input>moments/n-prop-lbsft</input>
			<input>propulsion/engine[2]/rotor/torque-target</input>
		</summer>

		<pure_gain>
			<input>propulsion/engine[2]/rotor/torque-error</input>
			<gain>0.000001</gain>
			<output>propulsion/engine[2]/rotor/torque-output</output>
		</pure_gain>

		<summer>
			<input>propulsion/engine[2]/rotor/torque-output</input>
			<input>propulsion/engine[2]/blade-angle</input>
			<clipto>
				<min>-6.1</min>
				<max>4.3</max>
			</clipto>
			<output>propulsion/engine[2]/blade-angle</output>
		</summer>

	</channel>

</system>









