	<!-- Blade incident Angle	 -->
	
		<fcs_function name="propulsion/engine[1]/rotor/blade-angle">
			<function>
				<ifthen>
					<eq>
						<property>/controls/electric/rotor_brake-sw</property>
						<value>1</value>
					</eq>
					<property>propulsion/engine[1]/rotor/blade-angle</property>
					<property>propulsion/engine[1]/blade-angle</property>
				</ifthen>
			</function>
		</fcs_function>
		
		<fcs_function name="propulsion/engine[1]/rotor/blade_1/blade-angle">																		
			<function>																	
				<sum>																
					<property>propulsion/engine[1]/rotor/blade-angle</property>															
					<product>															
						<sin>														
							<property>propulsion/engine[1]/rotor/blade_1/rotation-rad</property>													
						</sin>														
						<table>														
							<independentVar>fcs/Helicopter/cyclic_roll-cmd-norm</independentVar>													
							<tableData>													
								-1	-5											
								1	5											
							</tableData>													
						</table>														
					</product>															
					<product>															
						<cos>														
							<property>propulsion/engine[1]/rotor/blade_1/rotation-rad</property>													
						</cos>														
						<table>														
							<independentVar>fcs/Helicopter/cyclic_pitch-cmd-norm</independentVar>													
							<tableData>													
								-1	-5											
								1	5											
							</tableData>													
						</table>														
					</product>															
				</sum>																
			</function>
			<clipto>						
				<min>-5</min>				
				<max>8.645</max>				
			</clipto>				
		</fcs_function>																		
																				
