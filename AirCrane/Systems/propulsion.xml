	<channel name="Main Rotor">

<!--   engine[1] = Main Rotor   -->

		<fcs_function name="propulsion/engine[1]/governor/cmd-rpm">
			<function>
				<max>
					<property>propulsion/gearbox/engine_1-rpm</property>
					<property>propulsion/gearbox/engine_2-rpm</property>
				</max>
			</function>
		</fcs_function>

		<summer name="propulsion/engine[1]/governor/error-rpm">
			<input>propulsion/engine[1]/engine-rpm</input>
			<input>-propulsion/engine[1]/governor/cmd-rpm</input>
		</summer>

		<pid>
			<input>-propulsion/engine[1]/governor/error-rpm</input>
			<kp>0.00005</kp>
			<ki>0.0000000001</ki>
			<kd>0.0001</kd>
			<output>propulsion/engine[1]/governor/output-rpm</output>
		</pid>

		<summer>
			<input>/controls/engines/engine[1]/throttle</input>
			<input>propulsion/engine[1]/governor/output-rpm</input>
			<output>/controls/engines/engine[1]/throttle</output>
		</summer>
		
	<!-- Blade Rotation Angle	 -->
		
		<fcs_function name="propulsion/engine[1]/rotor/frequency">
			<function>
				<product>
					<value>0.0167</value>
					<property>propulsion/engine[1]/engine-rpm</property> 
					<value>6.2831853</value>							<!-- pi * 2 -->
					<property>simulation/dt</property>
				</product>
			</function>
		</fcs_function>
		
		<fcs_function name="propulsion/engine[1]/rotor/blade_1/rotation-rad">
			<function>
				<ifthen>
					<le>
						<property>propulsion/engine[1]/rotor/blade_1/rotation-rad</property>
						<value>6.2831853</value>
					</le>
					<sum>
						<property>propulsion/engine[1]/rotor/blade_1/rotation-rad</property>
						<property>propulsion/engine[1]/rotor/frequency</property>
					</sum>
					<value>0</value>
				</ifthen>
			</function>
		</fcs_function>
		<fcs_function name="propulsion/engine[1]/rotor/blade_1/rotation-deg">
			<function>
				<todegrees>
					<property>propulsion/engine[1]/rotor/blade_1/rotation-rad</property>
				</todegrees>
			</function>
		</fcs_function>

		<fcs_function name="propulsion/engine[1]/rotor/blade_2/rotation-rad">
			<function>
				<ifthen>
					<and>
						<le>
							<property>propulsion/engine[1]/rotor/blade_1/rotation-rad</property>
							<value>1.047198</value>
						</le>
						<ge>
							<property>propulsion/engine[1]/rotor/blade_1/rotation-rad</property>
							<value>0</value>
						</ge>					
					</and>
					<sum>
						<property>propulsion/engine[1]/rotor/blade_1/rotation-rad</property>
						<value>5.235988</value>
					</sum>
					<sum>
						<property>propulsion/engine[1]/rotor/blade_1/rotation-rad</property>
