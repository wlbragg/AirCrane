<system name="Engine">

<property type="double" value="0">propulsion/tank[5]/fuel-bug</property>	
<property type="double" value="0">propulsion/tank_fwd/fuel-bug</property>	

	<channel name="Fwd Fuel Tank">
	
		<!-- Fuel Content -->

		<summer name="propulsion/tank_fwd/contents-lbs">
			<input>propulsion/tank[1]/contents-lbs</input>
			<input>propulsion/tank[2]/contents-lbs</input>
		</summer>		
 		<fcs_function>
			<function>
				<ifthen>
					<eq>
						<p>/controls/electric/cab_power</p>
						<v>1</v>
					</eq>
					<property>propulsion/tank_fwd/contents-lbs</property>
					<value>-99</value>
				</ifthen>
			</function>
			<output>propulsion/tank_fwd/contents-lbs</output>
		</fcs_function>	
		<actuator>
			<input>propulsion/tank_fwd/contents-lbs</input>
			<rate_limit>300</rate_limit>
			<output>/controls/electric/tank_fwd-lbs</output>
		</actuator>
							
	</channel>

<property type="double" value="0">propulsion/tank_aft/fuel-bug</property>		
				
	<channel name="Aft Fuel Tank">

		<!-- Fuel Content -->	
		
		<summer name="propulsion/tank_aft/contents-lbs">
 			<input>propulsion/tank[3]/contents-lbs</input>
			<input>propulsion/tank[4]/contents-lbs</input>
		</summer>
 		<fcs_function>
			<function>
				<ifthen>
					<eq>
						<p>/controls/electric/cab_power</p>
						<v>1</v>
					</eq>
					<property>propulsion/tank_aft/contents-lbs</property>
					<value>-99</value>
				</ifthen>
			</function>
			<output>propulsion/tank_aft/contents-lbs</output>
		</fcs_function>	
		<actuator>
			<input>propulsion/tank_aft/contents-lbs</input>
			<rate_limit>290</rate_limit>
			<output>/controls/electric/tank_aft-lbs</output>
		</actuator>
						
	</channel>		

<property type="double" value="0">propulsion/tank[5]/test</property>
	
	<channel name="Aux Fuel Tank Gauge">
	
 		<fcs_function>
			<function>
				<ifthen>
					<eq>
						<p>/controls/electric/cab_power</p>
						<v>1</v>
					</eq>
					<max>
						<property>propulsion/tank[5]/contents-lbs</property>
						<table>
							<independentVar>propulsion/tank[5]/test</independentVar>
							<tableData>
								0	0
								1	3300
							</tableData>
						</table>					
					</max>
					<value>-99</value>
				</ifthen>
			</function>
			<output>propulsion/tank_aux/contents-lbs</output>
		</fcs_function>	
		<actuator>
			<input>propulsion/tank_aux/contents-lbs</input>
			<rate_limit>294</rate_limit>
			<output>/controls/electric/tank_aux-lbs</output>
		</actuator>
			
	</channel>
	
	<channel name="Fuel Tank flow Gauge">
		
		<!-- Turbine No.1 -->

		<pure_gain>
			<input>propulsion/engine[3]/fuel-flow-rate-pps</input>
			<gain>60</gain>
			<output>propulsion/engine[3]/fuel-flow-rate-ppm</output>
		</pure_gain>
 		<fcs_function>
			<function>
				<ifthen>
					<eq>
						<p>/controls/electric/cab_power</p>
						<v>1</v>
					</eq>
					<property>propulsion/engine[3]/fuel-flow-rate-ppm</property>
					<value>-99</value>
				</ifthen>
			</function>
			<output>propulsion/engine[3]/fuel-flow-rate-ppm</output>
		</fcs_function>	
		<actuator>
			<input>propulsion/engine[3]/fuel-flow-rate-ppm</input>
			<rate_limit>300</rate_limit>
			<output>/controls/electric/turbine_1-flow-ppm</output>
		</actuator>
		
		<!-- Turbine No.2 -->

		<pure_gain>
			<input>propulsion/engine[4]/fuel-flow-rate-pps</input>
			<gain>60</gain>
			<output>propulsion/engine[4]/fuel-flow-rate-ppm</output>
		</pure_gain>
 		<fcs_function>
			<function>
				<ifthen>
					<eq>
						<p>/controls/electric/cab_power</p>
						<v>1</v>
					</eq>
					<property>propulsion/engine[4]/fuel-flow-rate-ppm</property>
					<value>-99</value>
				</ifthen>
			</function>
			<output>propulsion/engine[4]/fuel-flow-rate-ppm</output>
		</fcs_function>	
		<actuator>
			<input>propulsion/engine[4]/fuel-flow-rate-ppm</input>
			<rate_limit>300</rate_limit>
			<output>/controls/electric/turbine_2-flow-ppm</output>
		</actuator>	
		
	</channel>

	<channel name="Quadrant">
		
		<!-- Turbine No.1 -->

 		<kinematic>
			<input>/controls/engines/engine[3]/starter</input>
			<traverse>
				<setting>
					<position>0</position>
					<time>0</time>
				</setting>
				<setting>
					<position>1</position>
					<time>5</time>
				</setting>
			</traverse>
			<output>propulsion/engine[3]/fuel-starter</output>
		</kinematic>

 		<fcs_function>
			<function>
				<ifthen>
					<gt>
						<p>propulsion/engine[3]/governor/n1-lever</p>
						<v>0.42</v>
					</gt>
					<p>propulsion/engine[3]/fuel-cock</p>						
					<value>0</value>
				</ifthen>
			</function>
			<output>propulsion/engine[3]/fuel-cock</output>
		</fcs_function>

 		<fcs_function>
			<function>
				<ifthen>
					<and>
						<gt>
							<p>propulsion/engine[3]/fuel-starter</p>
							<v>0</v>
						</gt>
						<lt>
							<p>propulsion/engine[3]/fuel-starter</p>
							<v>1</v>
						</lt>
					</and>
					<value>1</value>
					<ifthen>
						<and>
							<or>
								<eq>
									<p>propulsion/tank_aux/pump-1</p>
									<v>1</v>
								</eq>
								<eq>
									<p>propulsion/tank_aux/pump-2</p>
									<v>1</v>
								</eq>							
							</or>
							<lt>
								<sum>
									<p>propulsion/tank_fwd/contents-lbs</p>
									<v>-5</v>
								</sum>							
								<p>propulsion/tank_fwd/fuel-bug</p>
							</lt>
							<gt>
								<p>propulsion/tank[5]/contents-lbs</p>
								<p>propulsion/tank[5]/fuel-bug</p>
							</gt>						
						</and>
						<v>0</v>
						<ifthen>
							<and>
								<or>
									<eq>
										<p>propulsion/tank_fwd/pump-1</p>
										<v>1</v>
									</eq>
									<eq>
										<p>propulsion/tank_fwd/pump-2</p>
										<v>1</v>
									</eq>						
								</or>
								<eq>
									<p>propulsion/engine[3]/fuel-cock</p>
									<v>1</v>
								</eq>						
							</and>
							<v>1</v>
							<v>0</v>
						</ifthen>
					</ifthen>						
				</ifthen>
			</function>
			<output>propulsion/tank[1]/priority</output>
			<output>propulsion/tank[2]/priority</output>
		</fcs_function>	
		
		
		<!-- Fuel Content Bug -->

		<fcs_function>
			<function>
				<ifthen>
					<and>
						<or>
							<eq>
								<p>propulsion/tank_aux/pump-1</p>
								<v>1</v>
							</eq>
							<eq>
								<p>propulsion/tank_aux/pump-2</p>
								<v>1</v>
							</eq>							
						</or>
						<lt>
							<p>propulsion/tank_fwd/contents-lbs</p>
							<p>propulsion/tank_fwd/fuel-bug</p>
						</lt>							
						<gt>
							<p>propulsion/tank[5]/contents-lbs</p>
							<p>propulsion/tank[5]/fuel-bug</p>
						</gt>						
					</and>
					<v>-5</v>
					<v>0</v>
				</ifthen>
			</function>
			<output>propulsion/tank_fwd/external-flow-rate-pps</output>
		</fcs_function>
		<pure_gain>
 			<input>-propulsion/tank_fwd/external-flow-rate-pps</input>
			<gain>0.5</gain>
			<output>propulsion/tank[1]/external-flow-rate-pps</output>
			<output>propulsion/tank[2]/external-flow-rate-pps</output>				
		</pure_gain>

		<!-- Turbine No.2 -->
		
  		<kinematic>
			<input>/controls/engines/engine[4]/starter</input>
			<traverse>
				<setting>
					<position>0</position>
					<time>0</time>
				</setting>
				<setting>
					<position>1</position>
					<time>5</time>
				</setting>
			</traverse>
			<output>propulsion/engine[4]/fuel-starter</output>
		</kinematic>

 		<fcs_function>
			<function>
				<ifthen>
					<gt>
						<p>propulsion/engine[4]/governor/n1-lever</p>
						<v>0.42</v>
					</gt>
					<p>propulsion/engine[4]/fuel-cock</p>					
					<value>0</value>
				</ifthen>
			</function>
			<output>propulsion/engine[4]/fuel-cock</output>
		</fcs_function>
		
 		<fcs_function>
			<function>
				<ifthen>
					<and>
						<gt>
							<p>propulsion/engine[4]/fuel-starter</p>
							<v>0</v>
						</gt>
						<lt>
							<p>propulsion/engine[4]/fuel-starter</p>
							<v>1</v>
						</lt>
					</and>
					<value>1</value>
					<ifthen>
						<and>
							<or>
								<eq>
									<p>propulsion/tank_aux/pump-1</p>
									<v>1</v>
								</eq>
								<eq>
									<p>propulsion/tank_aux/pump-2</p>
									<v>1</v>
								</eq>							
							</or>
							<lt>
								<sum>
									<p>propulsion/tank_aft/contents-lbs</p>
									<v>-5</v>
								</sum>							
								<p>propulsion/tank_aft/fuel-bug</p>
							</lt>
							<gt>
								<p>propulsion/tank[5]/contents-lbs</p>
								<p>propulsion/tank[5]/fuel-bug</p>
							</gt>						
						</and>
						<v>0</v>
						<ifthen>
							<and>
								<or>
									<eq>
										<p>propulsion/tank_aft/pump-1</p>
										<v>1</v>
									</eq>
									<eq>
										<p>propulsion/tank_aft/pump-2</p>
										<v>1</v>
									</eq>						
								</or>
								<eq>
									<p>propulsion/engine[4]/fuel-cock</p>
									<v>1</v>
								</eq>						
							</and>
							<v>1</v>
							<v>0</v>
						</ifthen>
					</ifthen>						
				</ifthen>
			</function>
			<output>propulsion/tank[3]/priority</output>
			<output>propulsion/tank[4]/priority</output>
		</fcs_function>	
				
		<!-- Fuel Content Bug -->

		<fcs_function>
			<function>
				<ifthen>
					<and>
						<or>
							<eq>
								<p>propulsion/tank_aux/pump-1</p>
								<v>1</v>
							</eq>
							<eq>
								<p>propulsion/tank_aux/pump-2</p>
								<v>1</v>
							</eq>							
						</or>
						<lt>
							<p>propulsion/tank_aft/contents-lbs</p>
							<p>propulsion/tank_aft/fuel-bug</p>
						</lt>							
						<gt>
							<p>propulsion/tank[5]/contents-lbs</p>
							<p>propulsion/tank[5]/fuel-bug</p>
						</gt>						
					</and>
					<v>-5</v>
					<v>0</v>
				</ifthen>
			</function>
			<output>propulsion/tank_aft/external-flow-rate-pps</output>
		</fcs_function>
		<pure_gain>
 			<input>-propulsion/tank_aft/external-flow-rate-pps</input>
			<gain>0.5</gain>
			<output>propulsion/tank[3]/external-flow-rate-pps</output>
			<output>propulsion/tank[4]/external-flow-rate-pps</output>				
		</pure_gain>

		<summer>
 			<input>-propulsion/tank[1]/external-flow-rate-pps</input>
 			<input>-propulsion/tank[2]/external-flow-rate-pps</input>
 			<input>-propulsion/tank[3]/external-flow-rate-pps</input>
 			<input>-propulsion/tank[4]/external-flow-rate-pps</input>			
			<output>propulsion/tank[5]/external-flow-rate-pps</output>				
		</summer>		
		
	</channel>

</system>
