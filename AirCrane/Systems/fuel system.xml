<system name="Engine">

<property type="double" value="0">propulsion/tank_aux/fuel-bug</property>	
<property type="double" value="0">propulsion/tank_fwd/fuel-bug</property>	
<property type="double" value="0">propulsion/tank_aft/fuel-bug</property>
<property type="double" value="0">propulsion/tank[5]/test</property>	

	<channel name="Fuel Tank Content">
	
		<!-- FWD Content -->
		
 		<fcs_function>
			<function>
				<ifthen>
					<eq>
						<p>/controls/electric/cab_power</p>
						<v>1</v>
					</eq>
					<property>propulsion/tank[3]/contents-lbs</property>
					<value>-99</value>
				</ifthen>
			</function>
			<output>propulsion/tank_fwd/contents-lbs</output>
		</fcs_function>	
		<actuator>
			<input>propulsion/tank_fwd/contents-lbs</input>
			<rate_limit>300</rate_limit>
			<output>/controls/electric/tank_fwd-lbs</output>
		</actuator>

		<!-- AFT Content -->	
	
 		<fcs_function>
			<function>
				<ifthen>
					<eq>
						<p>/controls/electric/cab_power</p>
						<v>1</v>
					</eq>
					<property>propulsion/tank[4]/contents-lbs</property>
					<value>-99</value>
				</ifthen>
			</function>
			<output>propulsion/tank_aft/contents-lbs</output>
		</fcs_function>	
		<actuator>
			<input>propulsion/tank_aft/contents-lbs</input>
			<rate_limit>290</rate_limit>
			<output>/controls/electric/tank_aft-lbs</output>
		</actuator>
	
 		<fcs_function>
			<function>
				<ifthen>
					<eq>
						<p>/controls/electric/cab_power</p>
						<v>1</v>
					</eq>
					<max>
						<property>propulsion/tank[5]/contents-lbs</property>
						<table>
							<independentVar>propulsion/tank[5]/test</independentVar>
							<tableData>
								0	0
								1	3300
							</tableData>
						</table>					
					</max>
					<value>-99</value>
				</ifthen>
			</function>
			<output>propulsion/tank_aux/contents-lbs</output>
		</fcs_function>	
		<actuator>
			<input>propulsion/tank_aux/contents-lbs</input>
			<rate_limit>294</rate_limit>
			<output>/controls/electric/tank_aux-lbs</output>
		</actuator>
			
	</channel>
	
	<channel name="Fuel Tank flow Gauge">
		
		<!-- Turbine No.1 -->

		<pure_gain>
			<input>propulsion/engine[3]/fuel-flow-rate-pps</input>
			<gain>60</gain>
			<output>propulsion/engine[3]/fuel-flow-rate-ppm</output>
		</pure_gain>
 		<fcs_function>
			<function>
				<ifthen>
					<eq>
						<p>/controls/electric/cab_power</p>
						<v>1</v>
					</eq>
					<property>propulsion/engine[3]/fuel-flow-rate-ppm</property>
					<value>-99</value>
				</ifthen>
			</function>
			<output>propulsion/engine[3]/fuel-flow-rate-ppm</output>
		</fcs_function>	
		<actuator>
			<input>propulsion/engine[3]/fuel-flow-rate-ppm</input>
			<rate_limit>300</rate_limit>
			<output>/controls/electric/turbine_1-flow-ppm</output>
		</actuator>
		
		<!-- Turbine No.2 -->

		<pure_gain>
			<input>propulsion/engine[4]/fuel-flow-rate-pps</input>
			<gain>60</gain>
			<output>propulsion/engine[4]/fuel-flow-rate-ppm</output>
		</pure_gain>
 		<fcs_function>
			<function>
				<ifthen>
					<eq>
						<p>/controls/electric/cab_power</p>
						<v>1</v>
					</eq>
					<property>propulsion/engine[4]/fuel-flow-rate-ppm</property>
					<value>-99</value>
				</ifthen>
			</function>
			<output>propulsion/engine[4]/fuel-flow-rate-ppm</output>
		</fcs_function>	
		<actuator>
			<input>propulsion/engine[4]/fuel-flow-rate-ppm</input>
			<rate_limit>300</rate_limit>
			<output>/controls/electric/turbine_2-flow-ppm</output>
		</actuator>	
		
	</channel>

	<channel name="Auxiliary Fuel Transfer">

		<!-- Fuel Content Bug -->
			
		<fcs_function>
			<function>		
				<sum>
					<ifthen>
						<eq>
							<p>propulsion/tank_aux/pump-1</p>
							<v>1</v>
						</eq>
						<v>2.5</v>					
						<v>0</v>						
					</ifthen>					
					<ifthen>
						<eq>
							<p>propulsion/tank_aux/pump-2</p>
							<v>1</v>
						</eq>
						<v>2.5</v>					
						<v>0</v>						
					</ifthen>
				</sum>
			</function>
			<output>propulsion/tank_aux/fuel_transfer-pps</output>
		</fcs_function>		

	</channel>


<property type="double" value="0">/controls/engines/engine[3]/fuel-cock</property>	
<property type="double" value="0">/controls/engines/engine[4]/fuel-cock</property>	

	<channel name="Starter Fuel Line">
		
		<!-- Turbine No.1 -->
		
 		<fcs_function> <!-- need this because of the way JSBsim turbine starter is coded -->
			<function>
				<ifthen>
					<and>
						<eq>
							<p>/controls/engines/engine[3]/starter</p>
							<v>1</v>
						</eq>
						<eq>
							<p>/controls/electric/engine[3]/starter-sw</p>
							<v>1</v>
						</eq>
					</and>
					<value>1</value>					
					<value>0</value>
				</ifthen>
			</function>
			<output>propulsion/engine[3]/fuel-starter</output>
		</fcs_function>			

 		<fcs_function> <!-- isolates fuel if n1 lever less than 0.42 -->
			<function>
				<ifthen>
					<gt>
						<p>propulsion/engine[3]/governor/n1-lever</p>
						<v>0.42</v>
					</gt>
					<p>propulsion/engine[3]/fuel-cock</p>						
					<value>0</value>
				</ifthen>
			</function>
			<output>propulsion/engine[3]/fuel-cock</output>
		</fcs_function>
		
		<!-- Turbine No.2 -->
		
 		<fcs_function> <!-- need this because of the way JSBsim turbine starter is coded -->
			<function>
				<ifthen>
					<and>
						<eq>
							<p>/controls/engines/engine[4]/starter</p>
							<v>1</v>
						</eq>
						<eq>
							<p>/controls/electric/engine[4]/starter-sw</p>
							<v>1</v>
						</eq>
					</and>
					<value>1</value>					
					<value>0</value>
				</ifthen>
			</function>
			<output>propulsion/engine[4]/fuel-starter</output>
		</fcs_function>	

 		<fcs_function> <!-- isolates fuel if n1 lever less than 0.42 -->
			<function>
				<ifthen>
					<gt>
						<p>propulsion/engine[4]/governor/n1-lever</p>
						<v>0.42</v>
					</gt>
					<p>propulsion/engine[4]/fuel-cock</p>					
					<value>0</value>
				</ifthen>
			</function>
			<output>propulsion/engine[4]/fuel-cock</output>
		</fcs_function>		
				
	</channel>
	
	<channel name="Main Fuel Line">
		
		<!-- Fuel Isolation Cocks -->
		
 		<fcs_function>
			<function>
				<ifthen>
					<or>
						<gt>
							<p>propulsion/engine[3]/fuel-starter-delay</p>
							<v>0</v>
						</gt>
						<eq>
							<p>propulsion/engine[3]/fuel-cock</p>
							<v>1</v>
						</eq>
					</or>
					<v>1</v>
					<v>0</v>					
				</ifthen>
			</function>
			<output>propulsion/tank[1]/priority</output>
		</fcs_function>
 		<fcs_function>
			<function>
				<ifthen>		
					<or>
						<gt>
							<p>propulsion/engine[4]/fuel-starter-delay</p>
							<v>0</v>
						</gt>
						<eq>
							<p>propulsion/engine[4]/fuel-cock</p>
							<v>1</v>
						</eq>
					</or>					
					<v>1</v>
					<v>0</v>					
				</ifthen>
			</function>
			<output>propulsion/tank[2]/priority</output>
		</fcs_function>
		
		<!-- Fuel Enters Tank 1  -->
		
 		<fcs_function>
			<function>
				<ifthen>			
					<eq>
						<p>propulsion/tank_x_feed</p>
						<v>1</v>
					</eq>
					<ifthen> <!-- yes -->
						<or>
							<eq>
								<p>propulsion/tank_fwd/pump-1</p>
								<v>1</v>
							</eq>
							<eq>
								<p>propulsion/tank_fwd/pump-2</p>
								<v>1</v>
							</eq>
						</or>
						<p>propulsion/engine[3]/fuel-flow-rate-pps</p> <!-- yes -->						
						<ifthen> <!-- no -->
							<or>
								<eq>
									<p>propulsion/tank_aft/pump-1</p>
									<v>1</v>
								</eq>
								<eq>
									<p>propulsion/tank_aft/pump-2</p>
									<v>1</v>								
								</eq>				
							</or>
							<p>propulsion/engine[3]/fuel-flow-rate-pps</p> <!-- yes -->
							<v>0</v> <!-- no -->
						</ifthen>
					</ifthen>
					<ifthen> <!-- no -->
						<or>
							<eq>
								<p>propulsion/tank_fwd/pump-1</p>
								<v>1</v>
							</eq>
							<eq>
								<p>propulsion/tank_fwd/pump-2</p>
								<v>1</v>
							</eq>
						</or>
						<p>propulsion/engine[3]/fuel-flow-rate-pps</p> <!-- yes -->	
						<v>0</v> <!-- no -->
					</ifthen>						
				</ifthen>					
			</function>
			<output>propulsion/tank[1]/external-flow-rate-pps</output>
		</fcs_function>

		<!-- Fuel Exits Tank 3  -->
	
 		<fcs_function>
			<function>
				<ifthen>
					<and>
						<gt>
							<p>propulsion/tank_aux/fuel_transfer-pps</p>
							<v>0</v>
						</gt>
						<lt>
							<p>propulsion/tank_fwd/contents-lbs</p>
							<p>propulsion/tank_fwd/fuel-bug</p>
						</lt>
					</and>
					<ifthen> <!-- yes -->			
						<lt>
							<p>propulsion/tank_aft/contents-lbs</p>
							<p>propulsion/tank_aft/fuel-bug</p>
						</lt>
						<sum> <!-- yes -->	
							<product> 
								<v>0.5</v>
								<p>propulsion/tank_aux/fuel_transfer-pps</p>
							</product>
							<p>-propulsion/tank[1]/external-flow-rate-pps</p>
						</sum>							
						<sum> <!-- no -->
							<p>propulsion/tank_aux/fuel_transfer-pps</p>
							<p>-propulsion/tank[1]/external-flow-rate-pps</p>
						</sum>
					</ifthen>						
					<ifthen> <!-- no -->
						<eq>
							<p>propulsion/tank_x_feed</p>
							<v>1</v>
						</eq>			
						<ifthen> <!-- yes -->
							<or>
								<eq>
									<p>propulsion/tank_fwd/pump-1</p>
									<v>1</v>
								</eq>
								<eq>
									<p>propulsion/tank_fwd/pump-2</p>
									<v>1</v>
								</eq>
							</or>				
							<ifthen> <!-- yes -->
								<or>
									<eq>
										<p>propulsion/tank_aft/pump-1</p>
										<v>1</v>
									</eq>
									<eq>
										<p>propulsion/tank_aft/pump-2</p>
										<v>1</v>
									</eq>
								</or>
								<sum> <!-- yes -->
									<product> 
										<v>0.5</v>
										<p>-propulsion/engine[3]/fuel-flow-rate-pps</p> 
									</product>
									<product> 
										<v>0.5</v>
										<p>-propulsion/engine[4]/fuel-flow-rate-pps</p> 
									</product>
								</sum>
								<sum> <!-- no -->
									<p>-propulsion/engine[3]/fuel-flow-rate-pps</p> 
									<p>-propulsion/engine[4]/fuel-flow-rate-pps</p> 									
								</sum>
							</ifthen>
							<v>0</v> <!-- no -->						
						</ifthen>						
						<p>-propulsion/tank[1]/external-flow-rate-pps</p> <!-- no -->
					</ifthen>
				</ifthen>
			</function>
			<output>propulsion/tank[3]/external-flow-rate-pps</output>
		</fcs_function>
		
		<!-- Fuel Enters Tank 2  -->
		
 		<fcs_function>
			<function>
				<ifthen>			
					<eq>
						<p>propulsion/tank_x_feed</p>
						<v>1</v>
					</eq>
					<ifthen> <!-- yes -->
						<or>
							<eq>
								<p>propulsion/tank_aft/pump-1</p>
								<v>1</v>
							</eq>
							<eq>
								<p>propulsion/tank_aft/pump-2</p>
								<v>1</v>
							</eq>
						</or>
						<p>propulsion/engine[4]/fuel-flow-rate-pps</p> <!-- yes -->						
						<ifthen> <!-- no -->
							<or>
								<eq>
									<p>propulsion/tank_fwd/pump-1</p>
									<v>1</v>
								</eq>
								<eq>
									<p>propulsion/tank_fwd/pump-2</p>
									<v>1</v>								
								</eq>				
							</or>
							<p>propulsion/engine[4]/fuel-flow-rate-pps</p> <!-- yes -->
							<v>0</v> <!-- no -->
						</ifthen>
					</ifthen>
					<ifthen> <!-- no -->
						<or>
							<eq>
								<p>propulsion/tank_aft/pump-1</p>
								<v>1</v>
							</eq>
							<eq>
								<p>propulsion/tank_aft/pump-2</p>
								<v>1</v>
							</eq>
						</or>
						<p>propulsion/engine[4]/fuel-flow-rate-pps</p> <!-- yes -->	
						<v>0</v> <!-- no -->
					</ifthen>						
				</ifthen>					
			</function>
			<output>propulsion/tank[2]/external-flow-rate-pps</output>
		</fcs_function>

		<!-- Fuel Exits Tank 4  -->
	
		<fcs_function>
			<function>
				<ifthen>
					<and>
						<gt>
							<p>propulsion/tank_aux/fuel_transfer-pps</p>
							<v>0</v>
						</gt>
						<lt>
							<p>propulsion/tank_aft/contents-lbs</p>
							<p>propulsion/tank_aft/fuel-bug</p>
						</lt>
					</and>
					<ifthen> <!-- yes -->			
						<lt>
							<p>propulsion/tank_fwd/contents-lbs</p>
							<p>propulsion/tank_fwd/fuel-bug</p>
						</lt>
						<sum> <!-- yes -->	
							<product> 
								<v>0.5</v>
								<p>propulsion/tank_aux/fuel_transfer-pps</p>
							</product>
							<p>-propulsion/tank[2]/external-flow-rate-pps</p>
						</sum>							
						<sum> <!-- no -->
							<p>propulsion/tank_aux/fuel_transfer-pps</p>
							<p>-propulsion/tank[2]/external-flow-rate-pps</p>
						</sum>
					</ifthen>						
					<ifthen> <!-- no -->
						<eq>
							<p>propulsion/tank_x_feed</p>
							<v>1</v>
						</eq>			
						<ifthen> <!-- yes -->
							<or>
								<eq>
									<p>propulsion/tank_aft/pump-1</p>
									<v>1</v>
								</eq>
								<eq>
									<p>propulsion/tank_aft/pump-2</p>
									<v>1</v>
								</eq>
							</or>				
							<ifthen> <!-- yes -->
								<or>
									<eq>
										<p>propulsion/tank_fwd/pump-1</p>
										<v>1</v>
									</eq>
									<eq>
										<p>propulsion/tank_fwd/pump-2</p>
										<v>1</v>
									</eq>
								</or>
								<sum> <!-- yes -->
									<product> 
										<v>0.5</v>
										<p>-propulsion/engine[4]/fuel-flow-rate-pps</p> 
									</product>
									<product> 
										<v>0.5</v>
										<p>-propulsion/engine[3]/fuel-flow-rate-pps</p> 
									</product>
								</sum>
								<sum> <!-- no -->
									<p>-propulsion/engine[4]/fuel-flow-rate-pps</p> 
									<p>-propulsion/engine[3]/fuel-flow-rate-pps</p> 									
								</sum>									
							</ifthen>
							<v>0</v> <!-- no -->						
						</ifthen>						
						<p>-propulsion/tank[2]/external-flow-rate-pps</p> <!-- no -->
					</ifthen>
				</ifthen>
			</function>
			<output>propulsion/tank[4]/external-flow-rate-pps</output>
		</fcs_function>
		
		<!-- Fuel Exits Tank 5  -->

 		<fcs_function>
			<function>
				<ifthen>
					<and>
						<or>
							<lt>
								<p>propulsion/tank_fwd/contents-lbs</p>
								<p>propulsion/tank_fwd/fuel-bug</p>
							</lt>
							<lt>
								<p>propulsion/tank_aft/contents-lbs</p>
								<p>propulsion/tank_aft/fuel-bug</p>
							</lt>							
						</or>
						<gt>
							<p>propulsion/tank_aux/contents-lbs</p>
							<p>propulsion/tank_aux/fuel-bug</p>
						</gt>
					</and>
					<p>-propulsion/tank_aux/fuel_transfer-pps</p>  <!-- yes -->
					<v>0</v> <!-- no -->
				</ifthen>
			</function>
			<output>propulsion/tank[5]/external-flow-rate-pps</output>
		</fcs_function>		
						
	</channel>

</system>
