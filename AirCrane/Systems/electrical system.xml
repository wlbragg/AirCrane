	<!-- Alarm Signals -->

	<!-- Rotor Brake Pressure -->
	
	
 		<fcs_function>
			<function>		
				<max>
					<p>/controls/rotor_brake/handle</p>				
					<p>/controls/rotor_brake/pressure-pump</p>
				</max>
			</function>
			<output>/controls/rotor_brake/pressure-pump</output>
		</fcs_function>	
		
 		<fcs_function>
			<function>
				<ifthen>
					<lt>
						<p>simulation/sim-time-sec</p>
						<v>1</v>
					</lt>
					<v>4</v> <!-- yes -->
					<ifthen> <!-- no -->
						<eq>
							<p>/controls/rotor_brake/handle</p>
							<v>0</v>
						</eq>
						<ifthen> <!-- yes -->
							<eq>
								<p>/controls/electric/rotor_brake</p>
								<v>1</v>
							</eq>
							<sum> <!-- yes -->
								<p>/controls/rotor_brake/pressure-pump</p>
								<p>/controls/rotor_brake/pressure-cylinder</p>
							</sum>
							<value>0</value> <!-- no -->
						</ifthen>						
						<p>/controls/rotor_brake/pressure-cylinder</p> <!-- no -->
					</ifthen>
				</ifthen>
			</function>
			<output>/controls/rotor_brake/pressure-cylinder</output>
		</fcs_function>		
 		<fcs_function>
			<function>		
				<ifthen>
					<eq>
						<p>/controls/rotor_brake/handle</p>
						<v>0</v>
					</eq>
					<value>0</value>					
					<p>/controls/rotor_brake/pressure-pump</p>
				</ifthen>
			</function>
			<output>/controls/rotor_brake/pressure-pump</output>
		</fcs_function>
		
		
