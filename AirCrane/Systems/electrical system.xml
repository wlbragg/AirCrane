	<channel name="Cab Power">
	
		<!-- Beginnings of cab power logic -->

		<fcs_function>
			<function>
				<ifthen>
					<and>
						<or>
							<eq>
								<p>/controls/electric/external_power</p>
								<v>1</v>
							</eq>
							<eq>
								<p>/controls/electric/APU-generator</p>
								<v>1</v>
							</eq>
							<eq>
								<p>propulsion/engine[3]/generator</p>
								<v>1</v>
							</eq>
							<eq>
								<p>propulsion/engine[4]/generator</p>
								<v>1</v>
							</eq>								
						</or>
						<eq>
							<p>/controls/electric/battery-isol</p>
							<v>1</v>
						</eq>
					</and>
					<value>1</value>
					<value>0</value>
				</ifthen>
			</function>
			<output>/controls/electric/battery-switch</output>
			<output>/controls/electric/cab_power</output>
			<output>/controls/electric/engine[3]/generator</output>
			<output>/controls/electric/engine[4]/generator</output>			
		</fcs_function>
		
 		<kinematic>
			<input>/controls/electric/cab_power</input>
			<traverse>
				<setting>
					<position>0</position>
					<time>0</time>
				</setting>
				<setting>
					<position>1</position>
					<time>5</time>
				</setting>
			</traverse>
			<output>/controls/electric/cws_power-up</output>
		</kinematic>

	</channel>

