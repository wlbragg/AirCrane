				</ifthen>
			</function>
			<output>propulsion/turbine_2/n1</output>
		</fcs_function>	
		<actuator>
			<input>propulsion/turbine_2/n1</input>
			<rate_limit>10</rate_limit>
			<output>/controls/electric/turbine_2-n1</output>
		</actuator>

