<system name="Engine">

<property type="double" value="0">propulsion/tank_aft/fuel-bug</property>		
				
	<channel name="engine">

		<!-- n1 -->	
		
 		<fcs_function>
			<function>
				<ifthen>
					<eq>
						<p>/controls/electric/cab_power</p>
						<v>1</v>
					</eq>
					<property>/fdm/jsbsim/propulsion/engine[3]/n1</property>
					<value>-99</value>
				</ifthen>
			</function>
			<output>propulsion/turbine_1/n1</output>
		</fcs_function>	
		<actuator>
			<input>propulsion/turbine_1/n1</input>
			<rate_limit>10</rate_limit>
			<output>/controls/electric/turbine_1-n1</output>
		</actuator>

 		<fcs_function>
			<function>
				<ifthen>
					<eq>
						<p>/controls/electric/cab_power</p>
