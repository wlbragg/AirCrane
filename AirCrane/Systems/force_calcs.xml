		<!-- Rotor Tilt -->
		
		<fcs_function name="propulsion/engine[1]/rotor/dihedral_0-deg">
			<function>
				<ifthen>
					<or>
						<gt>
							<property>propulsion/engine[1]/rotor/blade_1/rotation-deg</property>
							<value>357</value>
						</gt>
						<lt>
							<property>propulsion/engine[1]/rotor/blade_1/rotation-deg</property>
							<value>3</value>
						</lt>
					</or>
					<product>
						<property>propulsion/engine[1]/rotor/blade_1/flex-deg</property>
						<value>4</value>
					</product>
					<property>propulsion/engine[1]/rotor/dihedral_0-deg</property>
				</ifthen>
			</function>
		</fcs_function>
		
		<fcs_function name="propulsion/engine[1]/rotor/dihedral_90-deg">
			<function>
				<ifthen>
					<and>
