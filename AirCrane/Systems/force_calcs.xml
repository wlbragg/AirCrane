	<channel name="main rotor_forces">

		<!-- ####   Main Rotor Thrust   #### -->

		<fcs_function name="propulsion/engine[1]/rotor/thrust-lbs">
			<function>
				<product>
					<property>propulsion/engine[1]/rotor/vortex_ring</property>
					<property>propulsion/engine[1]/thrust-lbs</property>
					<value>-100000000</value>
				</product>
			</function>
		</fcs_function>

		<!-- Blade Thrust -->

		<fcs_function name="propulsion/engine[1]/rotor/blade_thrust-lbs">
			<function>
				<quotient>
					<property>propulsion/engine[1]/rotor/thrust-lbs</property>
					<value>6</value>		<!-- No. of Blades  -->
				</quotient>
			</function>
		</fcs_function>

		<!-- Force Distribution -->

		<fcs_function name="propulsion/engine[1]/rotor/blade_1/thrust-lbs">
			<function>
				<sum>
					<property>propulsion/engine[1]/rotor/blade_thrust-lbs</property>				
					<product>
						<property>propulsion/engine[1]/rotor/blade_thrust-lbs</property>					
						<sin>
							<property>propulsion/engine[1]/rotor/blade_1/rotation-rad</property>					
						</sin>
						<table>
							<independentVar>fcs/Helicopter/cyclic_roll-pos-norm</independentVar>
							<tableData>
								-1	-0.1
								1	0.1
							</tableData>
						</table>						
					</product>				
					<product>
						<property>propulsion/engine[1]/rotor/blade_thrust-lbs</property>					
						<cos>
							<property>propulsion/engine[1]/rotor/blade_1/rotation-rad</property>					
						</cos>
						<table>
							<independentVar>fcs/Helicopter/cyclic_pitch-pos-norm</independentVar>
							<tableData>
								-1	0.1
								1	-0.1
							</tableData>
						</table>						
					</product>
				</sum>
			</function>
		</fcs_function>

