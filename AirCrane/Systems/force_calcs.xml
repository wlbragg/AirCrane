		<!-- Blade Flapping -->
		
		<scheduled_gain name="propulsion/engine[1]/rotor/blade_1/flex-deg">
			<input>T4T/one</input>
			<table>
				<independentVar lookup="row">-propulsion/engine[1]/rotor/blade_1/thrust-lbs</independentVar>
				<independentVar lookup="column">propulsion/engine[1]/engine-rpm</independentVar>
				<tableData>
									0				75
					0				-2.00			0.00
					355				0.00			0.00
					833				0.01			0.01
					1667			0.03			0.03
					2500			0.05			0.05
					3333			0.10			0.10
					4167			0.25			0.25
					5000			0.50			0.50
					5833			0.90			0.90
					6667			1.50			1.50
					7500			2.50			2.50
				</tableData>
			</table>				
		</scheduled_gain>
		
		<scheduled_gain name="propulsion/engine[1]/rotor/blade_2/flex-deg">
			<input>T4T/one</input>
