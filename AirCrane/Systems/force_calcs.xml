							<value>87</value>
						</gt>
						<lt>
							<property>propulsion/engine[1]/rotor/blade_1/rotation-deg</property>
							<value>93</value>
						</lt>
					</and>
					<product>
						<property>propulsion/engine[1]/rotor/blade_1/flex-deg</property>
						<value>4</value>
					</product>
					<property>propulsion/engine[1]/rotor/dihedral_90-deg</property>
				</ifthen>
			</function>
		</fcs_function>
		
