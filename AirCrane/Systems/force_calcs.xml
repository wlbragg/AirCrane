		<fcs_function name="propulsion/engine[1]/rotor/dihedral_roll-rad">
			<function>
				<toradians>
					<sum>
						<value>-3</value> <!-- rotor rigging angle -->
						<property>propulsion/engine[1]/rotor/dihedral_90-deg</property>
						<property>-propulsion/engine[1]/rotor/dihedral_270-deg</property>					
					</sum>
				</toradians>
			</function>
		</fcs_function>			
		
		<fcs_function name="propulsion/engine[1]/rotor/dihedral_pitch-rad">
			<function>
				<toradians>
					<sum>
						<value>-3</value> <!-- rotor rigging angle -->
						<property>propulsion/engine[1]/rotor/dihedral_0-deg</property>
						<property>-propulsion/engine[1]/rotor/dihedral_180-deg</property>					
					</sum>
				</toradians>
			</function>
		</fcs_function>

		<!-- Centre of Pressure -->	
		
		<fcs_function>
			<function>
				<product>
					<abs><property>fcs/Helicopter/cyclic_roll-pos-norm</property></abs>	
					<property>propulsion/engine[1]/rotor/CoP_displacement-in</property>
					<sin>
						<atan2>
							<sum name="fcs/Helicopter/cyclic_roll-pos-norm">
								<property>fcs/Helicopter/cyclic_roll-cmd-norm</property>							
								<product> <!-- p damping -->
									<property>velocities/p-rad_sec</property>	
									<property>propulsion/engine[1]/rotor/damping-factor</property>	
								</product>
							</sum>	
							<sum name="fcs/Helicopter/cyclic_pitch-pos-norm">
								<property>fcs/Helicopter/cyclic_pitch-cmd-norm</property>
								<product> <!-- q damping -->
									<property>velocities/q-rad_sec</property>	
									<property>propulsion/engine[1]/rotor/damping-factor</property>	
								</product>
							</sum>	
						</atan2>
					</sin>				
				</product>
			</function>
			<output>external_reactions/rotor_main/location-y-in</output>			
		</fcs_function>

		<fcs_function>
			<function>
				<sum>
					<value>333.0709</value>			
					<product>
						<property>propulsion/engine[1]/rotor/CoP_displacement-in</property>
						<cos>
							<atan2>
								<property>fcs/Helicopter/cyclic_roll-pos-norm</property>		
								<property>fcs/Helicopter/cyclic_pitch-pos-norm</property>							
							</atan2>
						</cos>
						<abs><property>fcs/Helicopter/cyclic_pitch-pos-norm</property></abs>				
					</product>
				</sum>
			</function>
			<output>external_reactions/rotor_main/location-x-in</output>			
		</fcs_function>	
		
		<!-- Forces -->	
		
		<fcs_function name="propulsion/engine[1]/rotor/Y-lbs">
			<function>
				<product>
					<property>-propulsion/engine[1]/rotor/thrust-lbs</property>
					<sin><property>propulsion/engine[1]/rotor/dihedral_roll-rad</property></sin>
				</product>
			</function>
			<output>external_reactions/rotor_main/y</output>
		</fcs_function>

		<fcs_function name="propulsion/engine[1]/rotor/X-lbs">
			<function>
				<product>
					<property>propulsion/engine[1]/rotor/thrust-lbs</property>
					<sin><property>propulsion/engine[1]/rotor/dihedral_pitch-rad</property></sin>
				</product>
			</function>
			<output>external_reactions/rotor_main/x</output>
		</fcs_function>

		<fcs_function name="propulsion/engine[1]/rotor/Z-lbs">
			<function>
				<product>
					<property>propulsion/engine[1]/rotor/thrust-lbs</property>
					<cos><property>propulsion/engine[1]/rotor/dihedral_roll-rad</property></cos>
					<cos><property>propulsion/engine[1]/rotor/dihedral_pitch-rad</property></cos>
				</product>
			</function>
			<output>external_reactions/rotor_main/z</output>
		</fcs_function>

		<!-- Ground Effect -->

		<fcs_function name="propulsion/engine[1]/rotor/vertical-lbs">
			<function>
				<product>
					<property>propulsion/engine[1]/rotor/Z-lbs</property>				
					<cos><property>attitude/pitch-rad</property></cos>
					<cos><property>attitude/roll-rad</property></cos>
				</product>
			</function>
		</fcs_function>

