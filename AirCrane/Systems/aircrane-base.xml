<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList>

    <sim include="views.xml">

        <startup>
          <splash-texture>Aircraft/AirCrane/aircrane-splash.png</splash-texture>
        </startup>

        <sound>
          <path>Aircraft/AirCrane/Sounds/aircrane-sound.xml</path>
        </sound>

        <model>
          <path archive="y">Aircraft/AirCrane/Models/aircrane.xml</path>
        </model>

    </sim>

    <payload>
        <weight>
            <name type="string">Left Pilot</name>
            <weight-lb alias="/fdm/jsbsim/inertia/pointmass-weight-lbs[0]"/>
            <arm-in alias="/fdm/jsbsim/inertia/pointmass-location-X-inches[0]"/>
            <min-lb type="double">0.0</min-lb>
            <max-lb type="double">300.0</max-lb>
        </weight>
        <weight>
            <name type="string">Right Pilot</name>
            <weight-lb alias="/fdm/jsbsim/inertia/pointmass-weight-lbs[1]"/>
            <arm-in alias="/fdm/jsbsim/inertia/pointmass-location-X-inches[0]"/>
            <min-lb type="double">0.0</min-lb>
            <max-lb type="double">300.0</max-lb>
        </weight>
        <weight>
            <name type="string">Engineer</name>
            <weight-lb alias="/fdm/jsbsim/inertia/pointmass-weight-lbs[2]"/>
            <arm-in alias="/fdm/jsbsim/inertia/pointmass-location-X-inches[0]"/>
            <min-lb type="double">0.0</min-lb>
            <max-lb type="double">300.0</max-lb>
        </weight>
        <weight>
            <name type="string">Load Point</name>
            <weight-lb alias="/fdm/jsbsim/inertia/pointmass-weight-lbs[3]"/>
            <arm-in alias="/fdm/jsbsim/inertia/pointmass-location-X-inches[0]"/>
            <min-lb type="double">0.0</min-lb>
            <max-lb type="double">30000</max-lb>
        </weight>
    </payload>

    <nasal>
        <aircrane>
            <file>Aircraft/AirCrane/Nasal/autostart.nas</file>
            <file>Aircraft/AirCrane/Nasal/click-sound.nas</file>
            <file>Aircraft/AirCrane/Nasal/mouse-override.nas</file>
        </aircrane>
    </nasal>

</PropertyList>
