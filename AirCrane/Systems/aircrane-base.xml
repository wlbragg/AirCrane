<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList>

    <sim include="views.xml">

        <startup>
          <splash-texture>Aircraft/AirCrane/aircrane-splash.png</splash-texture>
        </startup>

        <sound>
          <path>Aircraft/AirCrane/Sounds/aircrane-sound.xml</path>
        </sound>

        <model>
          <path archive="y">Aircraft/AirCrane/Models/aircrane.xml</path>
        </model>

    </sim>

 	<input include="keyboard-T4T.xml">
		<joysticks>	
		<js>
			<axis>
				<desc type="string">Aileron</desc>
				<binding>
					<command type="string">property-scale</command>
					<property type="string">/controls/flight/aileron</property>
					<factor type="double">1</factor>
					<offset type="double">0</offset>
					<power type="double">1</power>
				</binding>
			</axis>
			<axis n="1">
				<desc type="string">Elevator</desc>
				<binding>
					<command type="string">property-scale</command>
					<property type="string">/controls/flight/elevator</property>
					<factor type="double">-1</factor>
					<offset type="double">0</offset>
					<power type="double">1</power>
				</binding>
			</axis>
			<axis n="2">
				<desc>Throttle</desc>
				<binding>
					<command>property-scale</command>
					<property>fdm/jsbsim/fcs/collective-cmd-norm</property>
				</binding>
			</axis>
			<axis>
				<desc>Rudder</desc>
				<binding>
					<command>property-scale</command>
					<property>/controls/flight/rudder</property>
				</binding>
			</axis>		
		</js>
		</joysticks>		
	</input>

</PropertyList>
